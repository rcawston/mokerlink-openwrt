// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * MokerLink POE-10G07110GSM
 * 7x 10GBASE-T (PoE++) + 1x 10G SFP+, Realtek RTL9303
 *
 * STAGE 1 DEVICE TREE: a conservative starting point, not a verified port.
 *
 * Confirmed from the board and the stock boot log:
 *   - SoC RTL9303, 128 MiB RAM, 16 MiB Winbond W25Q128 SPI NOR
 *   - stock flash layout as declared below
 *   - console on header J4 at 115200 8N1
 *   - vendor hardware profile RTL9303_8264B_3X8261BE_XGE_POE: one RTL8264B
 *     quad PHY plus three discrete RTL8261BE PHYs
 *   - PoE: two RTL8239-VB behind a PSE MCU; the stock SDK registers a UART
 *     and no I2C device, as on the Zyxel XMG1915-10EP (RTL8239 MCU on uart1)
 *   - an RTL8231 GPIO/LED expander (not used here yet)
 *   - stock U-Boot 2011.12 (1.0.0.2), firmware "KT-NOS" 1.1.1.34
 *
 * Everything marked UNVERIFIED still needs confirming. scripts/uboot-wiring.py
 * reads the PHY wiring and lane polarity from the vendor U-Boot
 * (docs/02-serial-console.md#read-the-port-wiring). Confirm everything before
 * the image is written to flash.
 *
 * Deliberately left out until confirmed, because a wrong guess there can
 * hurt stability rather than just disable a feature:
 *   - reset button: a floating or wrong GPIO makes /etc/rc.button/reset
 *     reboot or factory-reset the switch at random
 *   - GPIO LEDs: driving the wrong GPIO as an output can hold a PHY or the
 *     PoE controller in reset
 *   - port LED sets: without a "realtek,rtl9300-leds" node the switch keeps
 *     the LED setup the boot loader programmed
 *   - SFP cage I2C/GPIOs
 *   - the RTL8231 expander and anything wired to it
 */

/dts-v1/;

#include "rtl930x.dtsi"

#include <dt-bindings/phy/phy.h>

/ {
	compatible = "mokerlink,poe-10g07110gsm", "realtek,rtl9303-soc";
	model = "MokerLink POE-10G07110GSM";

	/*
	 * 128 MiB RAM ("DRAM: 128 MB") and the 115200 baud console of the
	 * vendor U-Boot are both the rtl930x.dtsi defaults.
	 */
};

&spi0 {
	status = "okay";

	flash@0 {
		/* Winbond W25Q128 (JEDEC ID EF4018) */
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		/*
		 * Same layout as the stock firmware's partition table. Everything
		 * except "firmware" is read-only so that OpenWrt never touches the
		 * boot loader, its environment, the board info or the stock
		 * configuration. That keeps a return to stock possible.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* stock: LOADER */
			partition@0 {
				label = "u-boot";
				reg = <0x0000000 0x00e0000>;
				read-only;
			};

			/* stock: BDINFO */
			partition@e0000 {
				label = "u-boot-env";
				reg = <0x00e0000 0x0010000>;
				read-only;
			};

			/* stock: SYSINFO */
			partition@f0000 {
				label = "u-boot-env2";
				reg = <0x00f0000 0x0010000>;
				read-only;
			};

			/* stock: JFFS2 CFG */
			partition@100000 {
				label = "jffs";
				reg = <0x0100000 0x0100000>;
				read-only;
			};

			/* stock: JFFS2 LOG */
			partition@200000 {
				label = "jffs2";
				reg = <0x0200000 0x0100000>;
				read-only;
			};

			/* stock: RUNTIME */
			partition@300000 {
				compatible = "openwrt,uimage", "denx,uimage";
				/*
				 * UNVERIFIED: must match UIMAGE_MAGIC in image/rtl930x.mk
				 * and the magic the boot loader accepts (md.b b4300000 4)
				 */
				openwrt,ih-magic = <0x83800000>;
				label = "firmware";
				reg = <0x0300000 0x0c00000>;
			};

			/* stock: OEMINFO */
			partition@f00000 {
				label = "oeminfo";
				reg = <0x0f00000 0x0100000>;
				read-only;
			};
		};
	};
};

/*
 * PHYs: an RTL8264B quad for lan1-4 and three discrete RTL8261BE for lan5-7.
 *
 * UNVERIFIED addresses: the quad on SMI bus 0 at 0-3 is common to every
 * comparable board. The RTL8261BEs are assumed on bus 1 at 4-6, following
 * the MokerLink 10GT080M (discrete RTL8261BEs numbered by port, second group
 * on bus 1). scripts/uboot-wiring.py decode prints the real lines.
 */
&mdio_bus0 {
	ethernet-phy-package@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		PHY_C45(0, 0)
		PHY_C45(8, 1)
		PHY_C45(16, 2)
		PHY_C45(20, 3)
	};
};

&mdio_bus1 {
	PHY_C45(24, 4)
	PHY_C45(25, 5)
	PHY_C45(26, 6)
};

/*
 * UNVERIFIED lane polarity: left at "normal" on both ends of every link.
 *
 * The RTL826x PHY driver (&phyN) and the switch SerDes driver (&serdesN)
 * both program polarity on every init and default to "normal", so a wrong
 * value silently kills traffic on that port: the link LED comes up but no
 * frames pass. scripts/uboot-wiring.py reads the values the vendor U-Boot
 * programs on both ends and prints the lines to add here, e.g.
 *	&phy8 { rx-polarity = <PHY_POL_INVERT>; };
 *	&serdes3 { rx-polarity = <PHY_POL_INVERT>; };
 * mokerlink-polarity-scan confirms a port from a running OpenWrt.
 */

&switch0 {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/* RJ45 10GBASE-T ports, lan1-7 */
		SWITCH_PORT_SDS(0, 1, 2, 0, usxgmii)
		SWITCH_PORT_SDS(8, 2, 3, 0, usxgmii)
		SWITCH_PORT_SDS(16, 3, 4, 0, usxgmii)
		SWITCH_PORT_SDS(20, 4, 5, 0, usxgmii)
		SWITCH_PORT_SDS(24, 5, 6, 0, usxgmii)
		SWITCH_PORT_SDS(25, 6, 7, 0, usxgmii)
		SWITCH_PORT_SDS(26, 7, 8, 0, usxgmii)

		/*
		 * SFP+ cage, lan8. UNVERIFIED: MAC port 27 on SerDes 9.
		 *
		 * Stage 1 runs the cage as a bare 10GBASE-R link with in-band
		 * status instead of a "sff,sfp" node, so no unconfirmed I2C bus
		 * or GPIO is touched. 10G optics, DAC cables and 10GBASE-T SFP+
		 * modules link up this way; 1G modules and module EEPROM/DOM
		 * readout need the full SFP description (docs/05-porting.md).
		 */
		port27: port@27 {
			reg = <27>;
			label = "lan8";
			pcs-handle = <&serdes9 0>;
			phy-mode = "10gbase-r";
			managed = "in-band-status";
		};

		/* CPU port */
		port@28 {
			ethernet = <&ethernet0>;
			reg = <28>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};

/*
 * PoE: the PSE MCU in front of the two RTL8239-VB.
 *
 * UNVERIFIED: uart1 at 115200 baud, as on the Zyxel XMG1915-10EP. If the
 * MCU does not answer, the driver logs an error and does nothing else;
 * check with: dmesg | grep -i pse. The PI order (which MCU port powers
 * which front port) is also UNVERIFIED: plug a PoE device into port 1 and
 * check that `ethtool --show-pse lan1` reports it.
 */
&uart1 {
	status = "okay";

	pse: ethernet-pse {
		compatible = "mokerlink,poe-10g07110gsm-pse", "realtek,pse-mcu-gen2";
		current-speed = <115200>;

		pse-pis {
			#address-cells = <1>;
			#size-cells = <0>;

			PSE_PI(0)
			PSE_PI(1)
			PSE_PI(2)
			PSE_PI(3)
			PSE_PI(4)
			PSE_PI(5)
			PSE_PI(6)
		};
	};
};

&phy0 { pses = <&pse_pi0>; };
&phy8 { pses = <&pse_pi1>; };
&phy16 { pses = <&pse_pi2>; };
&phy20 { pses = <&pse_pi3>; };
&phy24 { pses = <&pse_pi4>; };
&phy25 { pses = <&pse_pi5>; };
&phy26 { pses = <&pse_pi6>; };
