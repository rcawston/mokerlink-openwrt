From: Ross Cawston <ross@r-sc.ca>
Subject: [PATCH] net: pse-pd: make the static budget priorities take effect

With the static budget strategy, a PI whose request doesn't fit in the
budget of its power domain turns off the PIs of lower priority, a whole
priority level at a time, until it fits. Each is turned off with
pse_disable_pi_pol(), which then retries the power delivery of the PIs
waiting for power in the domain. The PI just turned off is one of them,
and the budget it freed is its own, so it is powered again right away:
the PI of higher priority doesn't get the budget, and the priorities
never take effect.

Only leaving out that retry would leave PIs off for nothing: PIs of
lower priority would be turned off also when that can't make room for
the request, and a whole priority level when fewer PIs are enough.

Instead, turn off PIs of lower priority only when the budget they hold,
with the unclaimed budget, makes room for the request, and then one at
a time, the lowest priority first and, within a priority, the PI that
holds the most, until the request fits. Then retry the power delivery
in the domain, for the PIs turned off whose budget wasn't needed in the
end. Only PIs that are enabled count and are turned off, and the retry
skips the PIs that hold budget, so that the PI being allocated, which
holds its budget but is not enabled yet, is left alone.
pse_disable_pi_pol() no longer retries the power domain.

Sashiko, the netdev AI review bot, pointed out the PIs left off for
nothing, in its review of "net: pse-pd: don't enable a PI again while
disabling it" (the Link below), which this applies on top of.
Build-tested only so far.

Fixes: ffef61d6d273 ("net: pse-pd: Add support for budget evaluation strategies")
Link: https://lore.kernel.org/netdev/179243532177.3135.6604862508015344848@kernel.org/
---
diff --git a/drivers/net/pse-pd/pse_core.c b/drivers/net/pse-pd/pse_core.c
index 8b03520..c1cf917 100644
--- a/drivers/net/pse-pd/pse_core.c
+++ b/drivers/net/pse-pd/pse_core.c
@@ -454,6 +454,12 @@ static void pse_pw_d_retry_power_delivery(struct pse_controller_dev *pcdev,
 		if (!pse_pi_is_admin_enable_pending(pcdev, i))
 			continue;
 
+		/* A PI that holds budget is being enabled, such as the PI
+		 * whose allocation retries the power domain
+		 */
+		if (pcdev->pi[i].pw_allocated_mW)
+			continue;
+
 		/* Do not try to enable PI with a lower prio (higher value)
 		 * than one which already can't be enabled.
 		 */
@@ -579,8 +585,6 @@ static int pse_disable_pi_pol(struct pse_controller_dev *pcdev, int id)
 	ret = _pse_pi_disable(pcdev, id);
 	if (ret)
 		notifs |= ETHTOOL_PSE_EVENT_SW_PW_CONTROL_ERROR;
-	else if (pse_pw_d_is_sw_pw_control(pcdev, pcdev->pi[id].pw_d))
-		pse_pw_d_retry_power_delivery(pcdev, pcdev->pi[id].pw_d);
 
 	ntf.notifs = notifs;
 	ntf.id = id;
@@ -591,34 +595,60 @@ static int pse_disable_pi_pol(struct pse_controller_dev *pcdev, int id)
 }
 
 /**
- * pse_disable_pi_prio - Disable all PIs of a given priority inside a PSE
- *			 power domain
+ * pse_pw_d_lower_prio_pw - Power budget held by the enabled PIs of a PSE power
+ *			    domain with a lower priority than a given one
  * @pcdev: a pointer to the PSE
  * @pw_d: a pointer to the PSE power domain
  * @prio: priority
  *
- * Return: 0 on success and failure value on error
+ * Return: the power budget in mW
  */
-static int pse_disable_pi_prio(struct pse_controller_dev *pcdev,
-			       struct pse_power_domain *pw_d,
-			       int prio)
+static int pse_pw_d_lower_prio_pw(struct pse_controller_dev *pcdev,
+				  struct pse_power_domain *pw_d, int prio)
 {
-	int i;
+	int i, pw = 0;
 
 	for (i = 0; i < pcdev->nr_lines; i++) {
-		int ret;
-
-		if (pcdev->pi[i].prio != prio ||
-		    pcdev->pi[i].pw_d != pw_d ||
+		if (pcdev->pi[i].pw_d != pw_d || pcdev->pi[i].prio <= prio ||
 		    pse_pi_is_hw_enabled(pcdev, i) <= 0)
 			continue;
 
-		ret = pse_disable_pi_pol(pcdev, i);
-		if (ret)
-			return ret;
+		pw += pcdev->pi[i].pw_allocated_mW;
 	}
 
-	return 0;
+	return pw;
+}
+
+/**
+ * pse_pw_d_pi_to_disable - Find the PI to disable to free power budget for a
+ *			    PI of a given priority inside a PSE power domain
+ * @pcdev: a pointer to the PSE
+ * @pw_d: a pointer to the PSE power domain
+ * @prio: priority of the PI that needs the budget
+ *
+ * Return: the index of the enabled PI that holds budget with the lowest
+ *	   priority below @prio, and of those the one that holds the most, or -1
+ *	   if there is none
+ */
+static int pse_pw_d_pi_to_disable(struct pse_controller_dev *pcdev,
+				  struct pse_power_domain *pw_d, int prio)
+{
+	int i, id = -1;
+
+	for (i = 0; i < pcdev->nr_lines; i++) {
+		struct pse_pi *pi = &pcdev->pi[i];
+
+		if (pi->pw_d != pw_d || !pi->pw_allocated_mW ||
+		    pi->prio <= prio || pse_pi_is_hw_enabled(pcdev, i) <= 0)
+			continue;
+
+		if (id < 0 || pi->prio > pcdev->pi[id].prio ||
+		    (pi->prio == pcdev->pi[id].prio &&
+		     pi->pw_allocated_mW > pcdev->pi[id].pw_allocated_mW))
+			id = i;
+	}
+
+	return id;
 }
 
 /**
@@ -631,8 +661,9 @@ static int pse_disable_pi_prio(struct pse_controller_dev *pcdev,
  * @extack: extack for error reporting
  *
  * Allocates power using static budget evaluation strategy, where allocation
- * is based on PD classification. When insufficient budget is available,
- * lower-priority ports (higher priority numbers) are turned off first.
+ * is based on PD classification. When insufficient budget is available, and
+ * the budget of lower-priority ports (higher priority numbers) makes room,
+ * they are turned off one at a time, the lowest priority first.
  *
  * Return: 0 on success and failure value on error
  */
@@ -641,25 +672,41 @@ pse_pi_allocate_pw_budget_static_prio(struct pse_controller_dev *pcdev, int id,
 				      int pw_req, struct netlink_ext_ack *extack)
 {
 	struct pse_pi *pi = &pcdev->pi[id];
-	int ret, _prio;
+	struct regulator *supply = pi->pw_d->supply;
+	bool disabled = false;
+	int ret, i;
 
-	_prio = pcdev->nr_lines;
-	while (regulator_request_power_budget(pi->pw_d->supply, pw_req) == -ERANGE) {
-		if (_prio <= pi->prio) {
-			NL_SET_ERR_MSG_FMT(extack,
-					   "PI %d: not enough power budget available",
-					   id);
-			return -ERANGE;
-		}
+	ret = regulator_request_power_budget(supply, pw_req);
+	if (ret == -ERANGE &&
+	    regulator_get_unclaimed_power_budget(supply) +
+	    pse_pw_d_lower_prio_pw(pcdev, pi->pw_d, pi->prio) >= pw_req) {
+		while (regulator_get_unclaimed_power_budget(supply) < pw_req) {
+			i = pse_pw_d_pi_to_disable(pcdev, pi->pw_d, pi->prio);
+			if (i < 0)
+				break;
 
-		ret = pse_disable_pi_prio(pcdev, pi->pw_d, _prio);
-		if (ret < 0)
-			return ret;
+			ret = pse_disable_pi_pol(pcdev, i);
+			if (ret)
+				return ret;
+
+			disabled = true;
+		}
 
-		_prio--;
+		ret = regulator_request_power_budget(supply, pw_req);
 	}
+	if (ret == -ERANGE)
+		NL_SET_ERR_MSG_FMT(extack,
+				   "PI %d: not enough power budget available",
+				   id);
+	if (ret)
+		return ret;
 
 	pi->pw_allocated_mW = pw_req;
+
+	/* Power the PIs turned off whose budget was not needed in the end */
+	if (disabled)
+		pse_pw_d_retry_power_delivery(pcdev, pi->pw_d);
+
 	return 0;
 }
 
