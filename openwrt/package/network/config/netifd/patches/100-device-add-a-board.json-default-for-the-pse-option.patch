Subject: [PATCH] device: add a board.json default for the pse option

With a power budget, a PSE controller can start with the admin state of
its PIs disabled, so a PoE port only delivers power once netifd enables
it with the pse option. Let a board give that option a default in
board.json, as it can for gro and the DSA conduit:

  "network_device": { "lan1": { "pse": true } }

A pse option in the device's section in UCI takes precedence, and
removing it there returns the port to the board's default. The default
is filled in where the UCI settings are parsed, so that it applies again
when a change to the section restarts the device, and when a device
without a section is claimed.

---
diff --git a/config.c b/config.c
index f9acae1..c3588e3 100644
--- a/config.c
+++ b/config.c
@@ -771,6 +771,24 @@ int config_get_default_gro(const char *ifname)
 	return blobmsg_get_bool(cur);
 }
 
+int config_get_default_pse(const char *ifname)
+{
+	struct blob_attr *cur;
+
+	if (!board_netdevs)
+		return -1;
+
+	cur = config_find_blobmsg_attr(board_netdevs, ifname, BLOBMSG_TYPE_TABLE);
+	if (!cur)
+		return -1;
+
+	cur = config_find_blobmsg_attr(cur, "pse", BLOBMSG_TYPE_BOOL);
+	if (!cur)
+		return -1;
+
+	return blobmsg_get_bool(cur);
+}
+
 const char *config_get_default_conduit(const char *ifname)
 {
 	struct blob_attr *cur;
diff --git a/config.h b/config.h
index 635a398..e3f5aef 100644
--- a/config.h
+++ b/config.h
@@ -22,6 +22,7 @@ extern bool config_init;
 int config_init_all(void);
 struct ether_addr *config_get_default_macaddr(const char *ifname);
 int config_get_default_gro(const char *ifname);
+int config_get_default_pse(const char *ifname);
 const char *config_get_default_conduit(const char *ifname);
 
 #endif
diff --git a/device.c b/device.c
index 31a929e..ac54165 100644
--- a/device.c
+++ b/device.c
@@ -383,6 +383,20 @@ device_set_extra_vlans(struct device *dev, struct blob_attr *data)
 			dev->n_extra_vlan++;
 }
 
+static void
+device_fill_default_pse(struct device *dev)
+{
+	struct device_settings *s = &dev->settings;
+	int ret;
+
+	ret = config_get_default_pse(dev->ifname);
+	if (ret < 0)
+		return;
+
+	s->pse = ret;
+	s->flags |= DEV_OPT_PSE;
+}
+
 void
 device_init_settings(struct device *dev, struct blob_attr **tb)
 {
@@ -616,6 +630,12 @@ device_init_settings(struct device *dev, struct blob_attr **tb)
 	if ((cur = tb[DEV_ATTR_PSE])) {
 		s->pse = blobmsg_get_bool(cur);
 		s->flags |= DEV_OPT_PSE;
+	} else {
+		/*
+		 * Kept like the settings from UCI, so that a restart of the
+		 * device applies it again
+		 */
+		device_fill_default_pse(dev);
 	}
 
 	if ((cur = tb[DEV_ATTR_PSE_PODL])) {
@@ -768,6 +788,10 @@ device_fill_default_settings(struct device *dev)
 			s->flags |= DEV_OPT_MASTER;
 		}
 	}
+
+	/* Devices without a section in UCI */
+	if (!(s->flags & DEV_OPT_PSE))
+		device_fill_default_pse(dev);
 }
 
 int device_claim(struct device_user *dep)
