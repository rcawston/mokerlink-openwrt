#!/bin/sh
# mokerlink-i2c-master-test
#
# Find out whether the RTL9303's own I2C master 1 drives the pins that the
# stock firmware bit-bangs: SCL on GPIO 8 and SDA on GPIO 9 (fan controller),
# 10 (PoE controllers) and 11 (SFP+ cage). If its SDA lines 0-2 are those
# pins, the device tree can use the upstream i2c-rtl9300 driver for the fan
# and SFP buses instead of bit-banging.
#
# It reads two ID registers per SDA line through the master, with devmem:
# ADT7476 0x2e register 0x3d (device ID, 0x76) and RTL8239 0x20 register
# 0x1b (ID, bits 7:3 = 7). Reads only; the I2C master registers are restored.
#
# The bit-banged buses are unbound for the test, which also unbinds the fan
# and PoE drivers. Power-cycle the switch afterwards.

GLB=0x1b000384          # I2C_MST_GLB_CTRL, bits 7:0 select SDA lines 0-7
CTRL1=0x1b00036c        # master 1: MEM_ADDR 31:8, SDA_OUT_SEL 6:4, SCL_SEL 3,
                        # RWOP 2 (1 = write), FAIL 1, TRIG 0
CTRL2=0x1b000370        # master 1: DEV_ADDR 14:8, DATA_WIDTH 7:4,
                        # MEM_ADDR_WIDTH 3:2, SCL_FREQ 1:0
DATA0=0x1b000374

hex() { printf '0x%02x' "$1"; }

# read_byte SDA ADDR REG -> prints the byte, or fails
read_byte() {
	local sda="$1" addr="$2" reg="$3" v i=0

	devmem $GLB 32 $(( $(devmem $GLB 32) | (1 << sda) ))
	devmem $CTRL2 32 $(( (addr << 8) | (0 << 4) | (1 << 2) ))
	devmem $CTRL1 32 $(( (reg << 8) | (sda << 4) | (1 << 3) ))
	devmem $CTRL1 32 $(( (reg << 8) | (sda << 4) | (1 << 3) | 1 ))
	while [ $(( $(devmem $CTRL1 32) & 1 )) -ne 0 ]; do
		i=$((i + 1))
		[ $i -ge 100 ] && { echo "timeout"; return 1; }
	done
	[ $(( $(devmem $CTRL1 32) & 2 )) -ne 0 ] && { echo "no ACK"; return 1; }
	v=$(( $(devmem $DATA0 32) & 0xff ))
	hex $v
}

command -v devmem >/dev/null || { echo "needs devmem" >&2; exit 1; }

drv=/sys/bus/platform/drivers/i2c-gpio-shared-scl
for d in "$drv"/*; do
	[ -L "$d" ] || continue
	[ -e "$d/driver" ] || continue   # a device, not "module"
	echo "unbinding the bit-banged buses (${d##*/})"
	echo "${d##*/}" >"$drv/unbind"
done

glb=$(devmem $GLB 32) c1=$(devmem $CTRL1 32) c2=$(devmem $CTRL2 32)
echo "saved: GLB_CTRL $glb CTRL1 $c1 CTRL2 $c2"

for sda in 0 1 2; do
	echo "SDA$sda: ADT7476 0x2e reg 0x3d: $(read_byte $sda 0x2e 0x3d)" \
		"(0x76 expected on the fan bus)"
	echo "SDA$sda: RTL8239 0x20 reg 0x1b: $(read_byte $sda 0x20 0x1b)" \
		"(0x38-0x3f expected on the PoE bus)"
done

devmem $CTRL2 32 "$c2"
devmem $CTRL1 32 $(( c1 & ~1 ))
devmem $GLB 32 "$glb"
echo "restored. Power-cycle the switch before using it again."
