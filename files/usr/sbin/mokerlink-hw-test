#!/bin/sh
# mokerlink-hw-test [OUTPUT_FILE]
#
# Guided test of the link change reporting and the PoE power budget.
# Records everything in one report:
#
#   1. link changes on port 2 with a device that is already up: one "Link
#      is Up" when plugged in and one "Link is Down" when unplugged
#   2. PoE with the budget: a PD on port 1 gets power once its class fits,
#      the budget follows it through switching the port off and on and
#      unplugging it, and port priorities can be set
#   3. optionally, an 802.3bt PD (class 5-8) on port 5: the class the chip
#      reports before and after powering it
#
# Prepare: boot the image from RAM, copy the PoE firmware
# (scp -O rtl8239-bt.bin root@<switch>:/tmp/), have a PoE device and a cable
# from another switch or router. Power-cycle the switch when it is done.

OUT=${1:-/tmp/mokerlink-hw-test-$(date +%Y%m%d-%H%M%S).txt}
FW_SRC=/tmp/rtl8239-bt.bin
FW_DST=/lib/firmware/realtek/rtl8239-bt.bin

say() { echo "$*" | tee -a "$OUT"; }
section() { printf '\n========== %s ==========\n' "$*" | tee -a "$OUT"; }
run() { printf '\n$ %s\n' "$*" >>"$OUT"; "$@" >>"$OUT" 2>&1; }
ask() { # prompt; waits for Enter, returns 1 on "s" (skip)
	local a
	printf '\n>>> %s\n    Enter when done, s + Enter to skip: ' "$*"
	read -r a </dev/tty
	echo ">>> $* [${a:-done}]" >>"$OUT"
	[ "$a" != s ]
}
note() { # question; records the typed answer
	local a
	printf '\n??? %s\n    answer + Enter: ' "$*" >/dev/tty
	read -r a </dev/tty
	echo "??? $* [$a]" >>"$OUT"
}

poe_bus() { # i2c bus number of the PoE controllers (SDA GPIO 10)
	local a
	for a in /sys/bus/i2c/devices/i2c-*; do
		case "$(cat "$a/name" 2>/dev/null)" in
		*i2c-gpio-shared*SDA1) echo "${a##*-}"; return 0 ;;
		esac
	done
	return 1
}

rd() { # addr reg: register as two hex digits
	local v
	v=$(i2cget -f -y "$BUS" "$1" "$2" 2>/dev/null) || { echo --; return; }
	echo "${v#0x}"
}

# regs ADDR: operating mode, power status, the Realtek-unknown 0x13/0x14
# (disconnect and detect/class enable on the TPS2388x) and channels 0-3
regs() {
	printf '  %s: 0x12 %s 0x10 %s 0x13 %s 0x14 %s  det/class %s %s %s %s\n' "$1" \
		"$(rd "$1" 0x12)" "$(rd "$1" 0x10)" "$(rd "$1" 0x13)" "$(rd "$1" 0x14)" \
		"$(rd "$1" 0x0c)" "$(rd "$1" 0x0d)" "$(rd "$1" 0x0e)" "$(rd "$1" 0x0f)" >>"$OUT"
}

budget() { # the PoE supply's budget and what the PSE core allotted of it
	local r
	for r in /sys/class/regulator/regulator.*; do
		[ "$(cat "$r/name" 2>/dev/null)" = poe ] || continue
		say "  budget $(cat "$r/power_budget_milliwatt" 2>/dev/null) mW, allotted $(cat "$r/power_requested_milliwatt" 2>/dev/null) mW"
		return
	done
	say "  no poe regulator"
}

pse() { # port: one-line PSE state
	ethtool --show-pse "$1" 2>/dev/null | sed -n \
		-e 's/.*Admin State: /admin /p' -e 's/.*Detection Status: /status /p' \
		-e 's/.*Power Class: /class /p' -e 's/.*Actual Power: /mW /p' \
		-e 's/.*[Pp]riority[^:]*: /prio /p' | tr '\n' ' '
}

# wait_status PORT STATUS SECONDS: until the PSE status matches, logging
# the state once a second
wait_status() {
	local t=0
	while [ $t -lt "$3" ]; do
		printf '  %2d s: %s\n' "$t" "$(pse "$1")" >>"$OUT"
		ethtool --show-pse "$1" 2>/dev/null | grep -q "Detection Status: $2" && {
			say "  $1: $2 after $t s"
			return 0
		}
		t=$((t + 1))
		sleep 1
	done
	say "  $1: not $2 after $3 s"
	return 1
}

link_msgs() { # port since: kernel link messages of the port after uptime "since"
	dmesg | awk -v p="$1: Link is" -v s="$2" '
		index($0, p) { t = substr($0, 2, index($0, "]") - 2) + 0; if (t >= s) print }'
}

uptime_s() { cut -d. -f1 /proc/uptime; }

: >"$OUT"
section "system"
run cat /etc/openwrt_release
run uname -a
run sh -c "uci show network | grep -E 'pse|name='"
BUS=$(poe_bus) || say "PoE I2C bus not found"

section "1: link changes on port 2"
if ask "Have a cable from another switch or router (already running) ready; press Enter, then plug it into port 2"; then
	since=$(uptime_s)
	sleep 15
	run sh -c "cat /sys/class/net/lan2/carrier /sys/class/net/lan2/speed"
	if ask "Unplug it from port 2, wait 5 s"; then
		sleep 2
		link_msgs lan2 "$since" | tee -a "$OUT"
		say "lan2: $(link_msgs lan2 "$since" | grep -c 'Link is Up') up, $(link_msgs lan2 "$since" | grep -c 'Link is Down') down (1 and 1 expected)"
	fi
fi

section "2: PoE with the budget, port 1"
if [ ! -f "$FW_DST" ] && [ -f "$FW_SRC" ]; then
	mkdir -p "${FW_DST%/*}"
	cp "$FW_SRC" "$FW_DST"
	say "waiting up to 90 s for the driver to load the firmware"
	t=0
	while [ "$(dmesg | grep -c 'rtl8239.*firmware running')" -lt 2 ] && [ $t -lt 90 ]; do
		sleep 5
		t=$((t + 5))
	done
fi
run sh -c "dmesg | grep -iE 'rtl8239|pse|poe'"
for p in lan1 lan2 lan3 lan4 lan5 lan6 lan7; do
	say "$p: $(pse $p)"
done
run ethtool --show-pse lan1
budget
regs 0x22
if ask "Plug the PoE device into port 1"; then
	wait_status lan1 delivering 30
	run ethtool --show-pse lan1
	budget
	regs 0x22
	note "Did the PoE device power up, and does its green PoE LED light? (y/n)"

	say "switching port 1 off"
	run ethtool --set-pse lan1 c33-pse-admin-control disable
	wait_status lan1 disabled 10
	budget
	regs 0x22
	say "switching port 1 on"
	run ethtool --set-pse lan1 c33-pse-admin-control enable
	wait_status lan1 delivering 30
	budget

	say "priority 5 for port 1 (0 is the highest)"
	run ethtool --set-pse lan1 prio 5
	run ethtool --show-pse lan1
	run ethtool --set-pse lan1 prio 0

	if ask "Unplug the PoE device from port 1, wait 5 s"; then
		wait_status lan1 searching 10
		budget
		regs 0x22
		if ask "Plug it back into port 1"; then
			wait_status lan1 delivering 30
			budget
			note "Did it power up again? (y/n)"
		fi
		ask "Unplug it from port 1" || true
	fi
fi

section "3: 802.3bt PD on port 5 (optional)"
if ask "If you have an 802.3bt PD (class 5-8, for example the T750SE): plug it into port 5 (s to skip)"; then
	t=0
	while [ $t -lt 30 ]; do
		printf '  %2d s: %s\n' "$t" "$(pse lan5)" >>"$OUT"
		regs 0x20
		ethtool --show-pse lan5 2>/dev/null | grep -q 'Detection Status: delivering' && break
		t=$((t + 1))
		sleep 1
	done
	sleep 10
	run ethtool --show-pse lan5
	budget
	regs 0x20
	run sh -c "dmesg | grep -i rtl8239 | tail -5"
	note "Did it power up and start? (y/n)"
	ask "Unplug it from port 5" || true
fi

section "kernel log"
run dmesg

echo
echo "Report: $OUT"
echo "Copy it off the switch with: scp -O root@<switch-ip>:$OUT ."
echo "Then power-cycle the switch."
