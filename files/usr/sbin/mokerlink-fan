#!/bin/sh
# mokerlink-fan
#
# Fan controller status. The ADT7476 runs the fans by itself in its
# automatic mode, which /etc/init.d/hwmon_fancontrol sets up at boot like
# the stock firmware runs them: all three PWM outputs follow the hottest of
# its three temperature sensors, 50 % up to 64 C, full speed from 66 C.

for h in /sys/class/hwmon/hwmon*; do
	[ "$(cat "$h/name" 2>/dev/null)" = adt7476 ] && break
	h=""
done
[ -n "$h" ] || { echo "no ADT7476 found"; exit 1; }

# pwmN_enable: 0 full speed (power-on default), 1 manual, 2 automatic
for f in "$h"/temp[123]_input "$h"/temp[123]_auto_point[12]_temp \
	 "$h"/fan[1234]_input "$h"/pwm[123] "$h"/pwm[123]_enable \
	 "$h"/pwm[123]_auto_channels_temp "$h"/pwm[123]_auto_point[12]_pwm \
	 "$h"/pwm[123]_stall_disable; do
	[ -f "$f" ] && echo "${f##*/}: $(cat "$f" 2>/dev/null)"
done
