#!/bin/sh /etc/rc.common
# Fan speed control (/usr/sbin/mokerlink-fan). Settings: /etc/config/mokerlink
# The fans run at full speed while this is not running.

# shellcheck disable=SC2034  # read by /etc/rc.common
START=19
USE_PROCD=1

start_service() {
	local enabled

	config_load mokerlink
	config_get_bool enabled fan enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/mokerlink-fan run
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mokerlink
}

# The daemon resets the fans itself when it stops; this covers one that hung
# and was killed.
service_stopped() {
	/usr/sbin/mokerlink-fan full
}
