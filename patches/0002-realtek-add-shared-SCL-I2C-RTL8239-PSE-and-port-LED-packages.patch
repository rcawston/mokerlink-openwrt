realtek: add shared-SCL I2C, RTL8239 PSE and port LED kernel packages

kmod-i2c-gpio-shared-scl: bit-banged I2C buses with one common SCL GPIO
(drivers/i2c/busses/i2c-gpio-shared-scl.c in files-6.18).

kmod-pse-realtek-rtl8239: Realtek RTL8239 PoE PSE controllers driven
directly over I2C (drivers/net/pse-pd/realtek-rtl8239.c in files-6.18).

kmod-leds-rtl9300-port: RTL9300 switch port LEDs under software control,
such as PoE status LEDs (drivers/leds/leds-rtl9300-port.c in files-6.18).

diff --git a/target/linux/realtek/modules.mk b/target/linux/realtek/modules.mk
index 5702500..0b49a8c 100644
--- a/target/linux/realtek/modules.mk
+++ b/target/linux/realtek/modules.mk
@@ -56,3 +56,52 @@ define KernelPackage/hasivo-mcu-sensor/description
 endef
 
 $(eval $(call KernelPackage,hasivo-mcu-sensor))
+
+define KernelPackage/i2c-gpio-shared-scl
+  SUBMENU:=$(I2C_MENU)
+  TITLE:=GPIO-based bitbanging I2C buses sharing one SCL line
+  KCONFIG:=CONFIG_I2C_GPIO_SHARED_SCL
+  FILES:=$(LINUX_DIR)/drivers/i2c/busses/i2c-gpio-shared-scl.ko
+  DEPENDS:=@TARGET_realtek +kmod-i2c-algo-bit
+  AUTOLOAD:=$(call AutoProbe,i2c-gpio-shared-scl,1)
+endef
+
+define KernelPackage/i2c-gpio-shared-scl/description
+ Several bitbanged I2C buses with one common SCL GPIO and one SDA GPIO
+ per bus, as on the MokerLink POE-10G07110GSM (fan controller, PoE
+ controllers and SFP cage).
+endef
+
+$(eval $(call KernelPackage,i2c-gpio-shared-scl))
+
+define KernelPackage/pse-realtek-rtl8239
+  TITLE:=Realtek RTL8239 PSE controller support
+  KCONFIG:=CONFIG_PSE_REALTEK_RTL8239
+  FILES:=$(LINUX_DIR)/drivers/net/pse-pd/realtek-rtl8239.ko
+  AUTOLOAD:=$(call AutoProbe,realtek-rtl8239)
+  $(call AddDepends/pse-pd,@TARGET_realtek +kmod-i2c-core)
+endef
+
+define KernelPackage/pse-realtek-rtl8239/description
+ Kernel module for Realtek RTL8239 PoE PSE controllers driven directly
+ over I2C, without a PSE microcontroller in front of them. The chip
+ firmware is not included; see the driver.
+endef
+
+$(eval $(call KernelPackage,pse-realtek-rtl8239))
+
+define KernelPackage/leds-rtl9300-port
+  SUBMENU:=$(LEDS_MENU)
+  TITLE:=Realtek RTL9300 switch port LED support
+  KCONFIG:=CONFIG_LEDS_RTL9300_PORT
+  FILES:=$(LINUX_DIR)/drivers/leds/leds-rtl9300-port.ko
+  DEPENDS:=@TARGET_realtek
+  AUTOLOAD:=$(call AutoProbe,leds-rtl9300-port)
+endef
+
+define KernelPackage/leds-rtl9300-port/description
+ Software control of RTL9300 switch port LEDs that have no hardware
+ function, such as the PoE status LEDs of PoE switches.
+endef
+
+$(eval $(call KernelPackage,leds-rtl9300-port))
