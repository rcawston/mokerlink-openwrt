# Pinned sources. Sourced by scripts/build.sh, scripts/check-dts.sh and CI.
#
# Everything is pinned to exact commits so that a build made today and a
# build made in six months produce the same firmware. Bump these on purpose,
# re-test on hardware, then commit.
#
# OpenWrt main is used instead of the 25.12 release because RTL9303 boards
# with RTL8264 10GBASE-T PHYs only work reliably on main: the 25.12 branch
# lacks the RTL8264 SerDes polarity handling (without it, ports link up but
# pass no traffic) and the Hasivo HS104 PoE driver.

OPENWRT_REPO=https://github.com/openwrt/openwrt.git
OPENWRT_COMMIT=6ca4da2c70d8e7fadcc550af76bca27af8fc1541   # main, 2026-10-15

# Kernel used by the realtek target at OPENWRT_COMMIT (target/linux/realtek/Makefile).
# Only the dt-bindings headers are taken from it, by scripts/check-dts.sh.
LINUX_REPO=https://github.com/torvalds/linux.git
LINUX_TAG=v6.18

OPENWRT_TARGET=realtek
OPENWRT_SUBTARGET=rtl930x
OPENWRT_DEVICE=mokerlink_poe-10g07110gsm
