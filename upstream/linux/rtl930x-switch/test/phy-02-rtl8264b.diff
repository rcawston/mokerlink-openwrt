diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
index b4d1e879fd9..cc8f5836b30 100644
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -147,6 +147,7 @@
 #define RTL_8261X_SUB_PHY_ID_ADDR		0x801d
 
 #define RTL826XB_VND1_MODEL			0x103
+#define  RTL826XB_VND1_MODEL_RTL8254B		0x8254
 #define  RTL826XB_VND1_MODEL_RTL8261N		0x8261
 
 #define RTL822X_VND1_SERDES_OPTION			0x697a
@@ -273,6 +274,7 @@
 #define RTL_8261CE_CG				0x001cc899
 #define RTL_8261D_VM				0x001cc89a
 #define RTL_8261N				0x001ccaf3
+#define RTL_8264B				0x001cc813
 
 #define RTL8261C_CE_MODEL		0x00
 #define RTL8261D_MODEL			0x81
@@ -2963,6 +2965,14 @@ static int rtl8261n_match_phy_device(struct phy_device *phydev,
 	       RTL826XB_VND1_MODEL_RTL8261N;
 }
 
+static int rtl8264b_match_phy_device(struct phy_device *phydev,
+				     const struct phy_driver *phydrv)
+{
+	int model = rtl826xb_model(phydev, RTL_8264B);
+
+	return model >= 0 && model != RTL826XB_VND1_MODEL_RTL8254B;
+}
+
 static int rtlgen_resume(struct phy_device *phydev)
 {
 	int ret = genphy_resume(phydev);
@@ -3565,6 +3575,12 @@ static struct phy_driver realtek_drvs[] = {
 		.get_features		= rtl826xb_get_features,
 		.config_aneg		= rtl8261x_config_aneg,
 		.read_status		= rtl8261x_read_status,
+	}, {
+		.match_phy_device	= rtl8264b_match_phy_device,
+		.name			= "Realtek RTL8264B 10Gbps PHY",
+		.get_features		= rtl826xb_get_features,
+		.config_aneg		= rtl8261x_config_aneg,
+		.read_status		= rtl8261x_read_status,
 	},
 };
 
