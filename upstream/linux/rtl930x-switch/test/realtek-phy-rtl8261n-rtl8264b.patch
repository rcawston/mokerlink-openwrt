Test image only, not part of the series: PHY driver entries for the
RTL8261N (parts marked RTL8261BE) and the RTL8264B of the MokerLink
POE-10G07110GSM, so that phylib reads 1000BASE-T links right. The generic
Clause 45 driver can't see the link partner's 1000BASE-T ability, which
these PHYs keep in their vendor registers, and takes a 1 Gb/s link for
100 Mb/s. The entries reuse net-next's RTL8261C/D functions for features,
autonegotiation and status, and do no reset and load no firmware: the
vendor U-Boot has set the PHYs up (rtk network on). The IDs are the ones
OpenWrt uses (target/linux/generic/pending-6.18/742-*).

--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -269,6 +269,8 @@
 #define RTL_8261C_CG				0x001cc898
 #define RTL_8261CE_CG				0x001cc899
 #define RTL_8261D_VM				0x001cc89a
+#define RTL_8261N				0x001ccaf3
+#define RTL_8264B				0x001cc813
 
 #define RTL8261C_CE_MODEL		0x00
 #define RTL8261D_MODEL			0x81
@@ -3520,6 +3522,18 @@
 		.soft_reset		= genphy_c45_pma_soft_reset,
 		.suspend		= genphy_c45_pma_suspend,
 		.resume			= genphy_c45_pma_resume,
+	}, {
+		PHY_ID_MATCH_EXACT(RTL_8261N),
+		.name			= "Realtek RTL8261N 10Gbps PHY",
+		.get_features		= rtl8261x_get_features,
+		.config_aneg		= rtl8261x_config_aneg,
+		.read_status		= rtl8261x_read_status,
+	}, {
+		PHY_ID_MATCH_EXACT(RTL_8264B),
+		.name			= "Realtek RTL8264B 10Gbps PHY",
+		.get_features		= rtl8261x_get_features,
+		.config_aneg		= rtl8261x_config_aneg,
+		.read_status		= rtl8261x_read_status,
 	},
 };
 
