# Kernel configuration for the RTL930x switch driver test image, merged
# on top of "make ARCH=mips allnoconfig". Test only.

# The Realtek MIPS SoCs
CONFIG_MACH_REALTEK_RTL=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_BIG_ENDIAN=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_HZ_250=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
# allnoconfig turns off the 32-bit time_t system calls, which the
# userspace's sleep and iperf3 use
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_REALTEK_OTTO=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_WATCHDOG=y
CONFIG_REALTEK_OTTO_WDT=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_MFD_SYSCON=y

# Flash, all read-only in the test device tree
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=y

# I2C on GPIOs, the SFP cage and, with -DWITH_PSE, the RTL8239s
CONFIG_I2C=y
CONFIG_I2C_GPIO=y

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_VLAN_8021Q=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_RTL9300_SWITCH=y
CONFIG_PHYLIB=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_REALTEK_RTL9300=y
CONFIG_REALTEK_PHY=y
CONFIG_SFP=y
CONFIG_ETHTOOL_NETLINK=y

# Debugging what the driver does
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DMA_API_DEBUG=y
CONFIG_PAGE_POOL_STATS=y
CONFIG_DYNAMIC_DEBUG=y
