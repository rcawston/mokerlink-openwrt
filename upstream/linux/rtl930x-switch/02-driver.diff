@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config RTL9300_SWITCH
+	tristate "Realtek RTL930x switch support"
+	depends on MACH_REALTEK_RTL || COMPILE_TEST
+	depends on OF
+	select MFD_SYSCON
+	help
+	  This driver supports the Ethernet switch built into the Realtek
+	  RTL9301, RTL9302B, RTL9302C and RTL9303 SoCs. Each switch port is
+	  a network interface of its own, and the CPU reaches the ports
+	  through the DMA engine of the switch.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rtl9300-switch.
