+#define RTL9300_DMA_RX_BASE(ring)		(0xdf00 + 4 * (ring))
+#define RTL9300_DMA_TX_BASE(ring)		(0xe000 + 4 * (ring))
+#define RTL9300_DMA_IF_INTR_RX_RUNOUT_MSK	0xe010
