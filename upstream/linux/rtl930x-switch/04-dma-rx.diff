diff --git a/drivers/net/ethernet/realtek/rtl9300/rtl9300_nic.c b/drivers/net/ethernet/realtek/rtl9300/rtl9300_nic.c
new file mode 100644
index 00000000000..6e391c259be
--- /dev/null
+++ b/drivers/net/ethernet/realtek/rtl9300/rtl9300_nic.c
@@ -0,0 +1,588 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Realtek RTL930x switch: the DMA engine of the CPU port
+ *
+ * The switch reaches the CPU through a DMA engine on its port 28, which the
+ * vendor calls the NIC. Frames move through rings of 32-bit entries, each
+ * holding the address of a descriptor and two flags: OWN, set while the
+ * hardware may use the descriptor, and WRAP on the last entry. A descriptor
+ * points to one buffer and carries the CPU tag, which says from which port a
+ * received frame came and to which ports a transmitted one goes; the tag is
+ * never part of the frame. A frame longer than one buffer spans descriptors.
+ * Received frames include their FCS, and transmitted ones leave room for it.
+ *
+ * The descriptor layout, the ring handling and the setup order follow
+ * OpenWrt's rtl838x_eth.c, by Birger Koblitz, Markus Stockhausen and other
+ * contributors.
+ *
+ * Copyright (C) 2026 Ross Cawston <ross@r-sc.ca>
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/interrupt.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <net/page_pool/helpers.h>
+
+#include "rtl9300.h"
+#include "rtl9300_regs.h"
+
+#define RTL9300_RING_OWN		BIT(0)
+#define RTL9300_RING_WRAP		BIT(1)
+
+/* Each receive buffer is a page pool fragment with the headroom, the up
+ * to 1568 bytes the hardware fills, and the skb_shared_info
+ */
+#define RTL9300_RX_HEADROOM		(NET_SKB_PAD + NET_IP_ALIGN)
+#define RTL9300_RX_BUF_SIZE		1568
+#define RTL9300_RX_FRAG_SIZE		\
+	SKB_HEAD_ALIGN(RTL9300_RX_HEADROOM + RTL9300_RX_BUF_SIZE)
+
+/* The ring counter must never let the ring overflow, so the ring takes as
+ * many frames as fit if each is of the longest length
+ */
+#define RTL9300_RX_RING_FRAMES		(RTL9300_RX_RING_SIZE / \
+					 DIV_ROUND_UP(RTL9300_MAX_FRAME, \
+						      RTL9300_RX_BUF_SIZE))
+
+/* Set in the offset word when the frame continues in the next descriptor */
+#define RTL9300_DESC_MORE		BIT(15)
+
+#define RTL9300_RX_TAG0_PORT		GENMASK(13, 8)
+
+struct rtl9300_desc {
+	__be32 addr;
+	__be16 reserved;
+	__be16 size;
+	__be16 offset;
+	__be16 len;
+	__be16 tag[10];
+};
+
+struct rtl9300_nic_rings {
+	__be32 rx_ring[RTL9300_RX_RING_SIZE];
+	struct rtl9300_desc rx_desc[RTL9300_RX_RING_SIZE];
+};
+
+static_assert(sizeof(struct rtl9300_desc) == 32);
+/* The width of the counter field */
+static_assert(RTL9300_RX_RING_FRAMES <= 0x3ff);
+
+static struct rtl9300_sw *rtl9300_nic_to_sw(struct rtl9300_nic *nic)
+{
+	return container_of(nic, struct rtl9300_sw, nic);
+}
+
+static dma_addr_t rtl9300_rx_desc_dma(struct rtl9300_nic *nic, unsigned int i)
+{
+	size_t offset = offsetof(struct rtl9300_nic_rings, rx_desc) +
+			sizeof(struct rtl9300_desc) * i;
+
+	return nic->rings_dma + offset;
+}
+
+/* Hands RX descriptor i to the hardware */
+static void rtl9300_rx_give(struct rtl9300_nic *nic, unsigned int i)
+{
+	u32 entry;
+
+	entry = lower_32_bits(rtl9300_rx_desc_dma(nic, i)) | RTL9300_RING_OWN;
+	if (i == RTL9300_RX_RING_SIZE - 1)
+		entry |= RTL9300_RING_WRAP;
+
+	/* The descriptor must be complete before the entry hands it over */
+	dma_wmb();
+	WRITE_ONCE(nic->rings->rx_ring[i], cpu_to_be32(entry));
+}
+
+static void rtl9300_rx_set_buf(struct rtl9300_nic *nic, unsigned int i,
+			       struct page *page, unsigned int offset)
+{
+	struct rtl9300_desc *desc = &nic->rings->rx_desc[i];
+	dma_addr_t dma;
+
+	dma = page_pool_get_dma_addr(page) + offset + RTL9300_RX_HEADROOM;
+
+	nic->rx_page[i] = page;
+	nic->rx_offset[i] = offset;
+	desc->addr = cpu_to_be32(lower_32_bits(dma));
+	desc->size = cpu_to_be16(RTL9300_RX_BUF_SIZE);
+	desc->offset = 0;
+	desc->len = 0;
+}
+
+static int rtl9300_rx_fill(struct rtl9300_nic *nic)
+{
+	for (unsigned int i = 0; i < RTL9300_RX_RING_SIZE; i++) {
+		unsigned int offset;
+		struct page *page;
+
+		page = page_pool_dev_alloc_frag(nic->pool, &offset,
+						RTL9300_RX_FRAG_SIZE);
+		if (!page)
+			return -ENOMEM;
+
+		rtl9300_rx_set_buf(nic, i, page, offset);
+		rtl9300_rx_give(nic, i);
+	}
+
+	nic->rx_head = 0;
+
+	return 0;
+}
+
+static void rtl9300_rx_free(struct rtl9300_nic *nic)
+{
+	for (unsigned int i = 0; i < RTL9300_RX_RING_SIZE; i++) {
+		if (!nic->rx_page[i])
+			continue;
+
+		page_pool_put_full_page(nic->pool, nic->rx_page[i], false);
+		nic->rx_page[i] = NULL;
+	}
+
+	if (nic->rx_skb) {
+		kfree_skb(nic->rx_skb);
+		nic->rx_skb = NULL;
+	}
+}
+
+/* The front port a received frame came from, in its first descriptor */
+static unsigned int rtl9300_rx_desc_port(const struct rtl9300_desc *desc)
+{
+	return FIELD_GET(RTL9300_RX_TAG0_PORT, be16_to_cpu(desc->tag[0]));
+}
+
+/* Adds the buffer of one descriptor to the frame being received. The page is
+ * used up either way: it is part of the frame, or back in the pool.
+ */
+static int rtl9300_rx_add(struct rtl9300_nic *nic, struct page *page,
+			  unsigned int offset, unsigned int len,
+			  const struct rtl9300_desc *desc)
+{
+	struct sk_buff *skb = nic->rx_skb;
+
+	page_pool_dma_sync_for_cpu(nic->pool, page,
+				   offset + RTL9300_RX_HEADROOM, len);
+
+	if (!skb) {
+		skb = napi_build_skb(page_address(page) + offset,
+				     RTL9300_RX_FRAG_SIZE);
+		if (!skb) {
+			page_pool_put_full_page(nic->pool, page, true);
+			return -ENOMEM;
+		}
+
+		skb_mark_for_recycle(skb);
+		skb_reserve(skb, RTL9300_RX_HEADROOM);
+		skb_put(skb, len);
+		nic->rx_skb = skb;
+		nic->rx_port = rtl9300_rx_desc_port(desc);
+		return 0;
+	}
+
+	if (skb_shinfo(skb)->nr_frags >= MAX_SKB_FRAGS) {
+		page_pool_put_full_page(nic->pool, page, true);
+		return -EMSGSIZE;
+	}
+
+	skb_add_rx_frag(skb, skb_shinfo(skb)->nr_frags, page,
+			offset + RTL9300_RX_HEADROOM, len,
+			RTL9300_RX_FRAG_SIZE);
+
+	return 0;
+}
+
+/* A complete frame, FCS included, from front port INDEX */
+static void rtl9300_rx_frame(struct rtl9300_sw *sw, struct sk_buff *skb,
+			     unsigned int index)
+{
+	if (skb->len < ETH_HLEN + ETH_FCS_LEN) {
+		kfree_skb_reason(skb, SKB_DROP_REASON_PKT_TOO_SMALL);
+		return;
+	}
+
+	if (pskb_trim(skb, skb->len - ETH_FCS_LEN)) {
+		kfree_skb_reason(skb, SKB_DROP_REASON_NOMEM);
+		return;
+	}
+
+	/* No port has a network interface yet */
+	kfree_skb_reason(skb, SKB_DROP_REASON_DEV_READY);
+}
+
+/* Receives up to BUDGET frames, and returns how many it took */
+static int rtl9300_rx(struct rtl9300_sw *sw, int budget)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+	int frames = 0;
+
+	while (frames < budget) {
+		unsigned int i = nic->rx_head, offset, new_offset, len;
+		struct rtl9300_desc *desc = &nic->rings->rx_desc[i];
+		struct page *page, *new_page;
+		bool more;
+		u32 entry;
+		int err;
+
+		entry = be32_to_cpu(READ_ONCE(nic->rings->rx_ring[i]));
+		if (entry & RTL9300_RING_OWN)
+			break;
+
+		/* The descriptor is complete once the hardware gave it back */
+		dma_rmb();
+
+		len = be16_to_cpu(desc->len);
+		more = be16_to_cpu(desc->offset) & RTL9300_DESC_MORE;
+		page = nic->rx_page[i];
+		offset = nic->rx_offset[i];
+
+		if (nic->rx_discard || len > RTL9300_RX_BUF_SIZE)
+			goto drop;
+
+		/* A new buffer first, so that a failure only loses the frame */
+		new_page = page_pool_dev_alloc_frag(nic->pool, &new_offset,
+						    RTL9300_RX_FRAG_SIZE);
+		if (!new_page)
+			goto drop;
+
+		err = rtl9300_rx_add(nic, page, offset, len, desc);
+		rtl9300_rx_set_buf(nic, i, new_page, new_offset);
+		if (err)
+			goto drop;
+
+		if (!more) {
+			struct sk_buff *skb = nic->rx_skb;
+
+			nic->rx_skb = NULL;
+			frames++;
+			rtl9300_rx_frame(sw, skb, nic->rx_port);
+		}
+		goto next;
+
+drop:
+		/* The rest of a frame that lost a buffer is dropped too */
+		if (nic->rx_skb) {
+			kfree_skb(nic->rx_skb);
+			nic->rx_skb = NULL;
+		}
+		nic->rx_discard = more;
+		if (!more)
+			frames++;
+
+		/* The descriptor goes back with the buffer it now has */
+		rtl9300_rx_set_buf(nic, i, nic->rx_page[i], nic->rx_offset[i]);
+next:
+		rtl9300_rx_give(nic, i);
+		nic->rx_head = (i + 1) % RTL9300_RX_RING_SIZE;
+	}
+
+	/* The ring counter counts frames; writing N frees space for N more */
+	if (frames)
+		regmap_write(sw->map, RTL9300_DMA_IF_RX_RING_CNTR(0),
+			     FIELD_PREP(RTL9300_DMA_IF_RX_RING_FIELD(0),
+					frames));
+
+	return frames;
+}
+
+static void rtl9300_nic_irq_enable(struct rtl9300_sw *sw)
+{
+	regmap_set_bits(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_MSK, BIT(0));
+	regmap_set_bits(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_MSK, BIT(0));
+}
+
+/* Masks and acknowledges every interrupt of the DMA engine */
+static void rtl9300_nic_irq_disable_all(struct rtl9300_sw *sw)
+{
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_MSK, 0);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_MSK, 0);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_TX_DONE_MSK, 0);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_STS, U32_MAX);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_STS, U32_MAX);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_TX_DONE_STS, U32_MAX);
+}
+
+static irqreturn_t rtl9300_nic_irq(int irq, void *data)
+{
+	struct rtl9300_sw *sw = data;
+	u32 runout, done;
+
+	regmap_read(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_STS, &runout);
+	regmap_read(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_STS, &done);
+	runout &= BIT(0);
+	done &= BIT(0);
+	if (!runout && !done)
+		return IRQ_NONE;
+
+	/* Masked until the poll has caught up */
+	regmap_clear_bits(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_MSK, BIT(0));
+	regmap_clear_bits(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_MSK, BIT(0));
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_RUNOUT_STS, runout);
+	regmap_write(sw->map, RTL9300_DMA_IF_INTR_RX_DONE_STS, done);
+
+	napi_schedule(&sw->nic.napi);
+
+	return IRQ_HANDLED;
+}
+
+static int rtl9300_nic_poll(struct napi_struct *napi, int budget)
+{
+	struct rtl9300_nic *nic = container_of(napi, struct rtl9300_nic, napi);
+	struct rtl9300_sw *sw = rtl9300_nic_to_sw(nic);
+	int frames;
+
+	frames = rtl9300_rx(sw, budget);
+	if (frames < budget && napi_complete_done(napi, frames))
+		rtl9300_nic_irq_enable(sw);
+
+	return frames;
+}
+
+/* Stops the DMA engine and the CPU port and resets the engine and its
+ * queues, with the settling times OpenWrt uses. Afterwards the engine
+ * touches no memory.
+ */
+static int rtl9300_nic_reset(struct rtl9300_sw *sw)
+{
+	u32 val;
+	int err;
+
+	err = regmap_clear_bits(sw->map, RTL9300_DMA_IF_CTRL,
+				RTL9300_DMA_IF_TXRX_EN);
+	if (err)
+		return err;
+
+	err = regmap_clear_bits(sw->map,
+				RTL9300_MAC_L2_PORT_CTRL(RTL9300_CPU_PORT),
+				RTL9300_MAC_L2_PORT_TXRX_EN);
+	if (err)
+		return err;
+
+	msleep(100);
+
+	err = regmap_set_bits(sw->map, RTL9300_RST_GLB_CTRL_0,
+			      RTL9300_RST_NIC_QUEUES);
+	if (err)
+		return err;
+
+	err = regmap_read_poll_timeout(sw->map, RTL9300_RST_GLB_CTRL_0, val,
+				       !(val & RTL9300_RST_NIC_QUEUES),
+				       1000, 1000000);
+	if (err)
+		return err;
+
+	msleep(100);
+
+	/* Writing back what the RX ring counter holds clears it */
+	err = regmap_read(sw->map, RTL9300_DMA_IF_RX_RING_CNTR(0), &val);
+	if (err)
+		return err;
+
+	return regmap_write(sw->map, RTL9300_DMA_IF_RX_RING_CNTR(0), val);
+}
+
+static int rtl9300_nic_setup(struct rtl9300_sw *sw)
+{
+	/* The rings sit below 4 GiB */
+	u32 rings = lower_32_bits(sw->nic.rings_dma);
+	u32 reg;
+	int err;
+
+	err = regmap_write(sw->map, RTL9300_DMA_RX_BASE(0),
+			   rings + offsetof(struct rtl9300_nic_rings, rx_ring));
+	if (err)
+		return err;
+
+	err = regmap_update_bits(sw->map, RTL9300_DMA_IF_RX_RING_SIZE(0),
+				 RTL9300_DMA_IF_RX_RING_FIELD(0),
+				 FIELD_PREP(RTL9300_DMA_IF_RX_RING_FIELD(0),
+					    RTL9300_RX_RING_FRAMES));
+	if (err)
+		return err;
+
+	/* Every trap reason to CPU queue 0, which is RX ring 0. The other
+	 * rings stay as the boot loader left them, as OpenWrt leaves the
+	 * rings it doesn't use.
+	 */
+	for (int n = 0; n < RTL9300_QM_RSN2CPUQID_REGS; n++) {
+		err = regmap_write(sw->map, RTL9300_QM_RSN2CPUQID_CTRL(n), 0);
+		if (err)
+			return err;
+	}
+
+	/* The ports limit the frame length; the CPU port takes them all */
+	err = regmap_update_bits(sw->map, RTL9300_MAC_L2_CPU_MAX_LEN_CTRL,
+				 RTL9300_MAC_CPU_MAX_LEN,
+				 FIELD_PREP(RTL9300_MAC_CPU_MAX_LEN,
+					    RTL9300_MAX_FRAME));
+	if (err)
+		return err;
+
+	reg = RTL9300_MAC_L2_PORT_MAX_LEN_CTRL(RTL9300_CPU_PORT);
+	err = regmap_update_bits(sw->map, reg,
+				 RTL9300_MAC_MAX_LEN_10_100 |
+				 RTL9300_MAC_MAX_LEN,
+				 FIELD_PREP(RTL9300_MAC_MAX_LEN_10_100,
+					    RTL9300_MAX_FRAME) |
+				 FIELD_PREP(RTL9300_MAC_MAX_LEN,
+					    RTL9300_MAX_FRAME));
+	if (err)
+		return err;
+
+	/* Truncation would cut frames short rather than drop them */
+	return regmap_clear_bits(sw->map, RTL9300_DMA_IF_CTRL,
+				 RTL9300_DMA_IF_RX_TRUNCATE_EN);
+}
+
+static int rtl9300_nic_start(struct rtl9300_sw *sw)
+{
+	int err;
+
+	err = regmap_set_bits(sw->map, RTL9300_DMA_IF_CTRL,
+			      RTL9300_DMA_IF_TXRX_EN);
+	if (err)
+		return err;
+
+	err = regmap_set_bits(sw->map,
+			      RTL9300_MAC_L2_PORT_CTRL(RTL9300_CPU_PORT),
+			      RTL9300_MAC_L2_PORT_TXRX_EN |
+			      RTL9300_MAC_L2_PORT_CRC_CHECK);
+	if (err)
+		return err;
+
+	/* The link between switch and DMA engine is up, at full duplex */
+	err = regmap_write(sw->map,
+			   RTL9300_MAC_FORCE_MODE_CTRL(RTL9300_CPU_PORT),
+			   RTL9300_MAC_FORCE_EN | RTL9300_MAC_FORCE_LINK |
+			   RTL9300_MAC_FORCE_DUPLEX |
+			   FIELD_PREP(RTL9300_MAC_FORCE_SPEED,
+				      RTL9300_MAC_FORCE_SPEED_1000) |
+			   RTL9300_MAC_FORCE_FC_EN);
+	if (err)
+		return err;
+
+	rtl9300_nic_irq_enable(sw);
+
+	return 0;
+}
+
+static void rtl9300_nic_stop(struct rtl9300_sw *sw)
+{
+	regmap_clear_bits(sw->map,
+			  RTL9300_MAC_FORCE_MODE_CTRL(RTL9300_CPU_PORT),
+			  RTL9300_MAC_FORCE_LINK);
+
+	if (rtl9300_nic_reset(sw))
+		dev_err(sw->dev, "failed to reset the DMA engine\n");
+}
+
+int rtl9300_nic_init(struct rtl9300_sw *sw, int irq)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+	struct page_pool_params pp = {
+		.order = 0,
+		.flags = PP_FLAG_DMA_MAP | PP_FLAG_DMA_SYNC_DEV,
+		.pool_size = RTL9300_RX_RING_SIZE,
+		.nid = NUMA_NO_NODE,
+		.dev = sw->dev,
+		.napi = &nic->napi,
+		.dma_dir = DMA_FROM_DEVICE,
+		.offset = 0,
+		.max_len = PAGE_SIZE,
+	};
+	int err;
+
+	/* A buffer has to fit in a page */
+	BUILD_BUG_ON(RTL9300_RX_FRAG_SIZE > PAGE_SIZE);
+
+	nic->irq = irq;
+
+	err = dma_set_mask_and_coherent(sw->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	nic->rings = dmam_alloc_coherent(sw->dev, sizeof(*nic->rings),
+					 &nic->rings_dma, GFP_KERNEL);
+	if (!nic->rings)
+		return -ENOMEM;
+
+	nic->napi_dev = alloc_netdev_dummy(0);
+	if (!nic->napi_dev)
+		return -ENOMEM;
+
+	netif_napi_add(nic->napi_dev, &nic->napi, rtl9300_nic_poll);
+
+	nic->pool = page_pool_create(&pp);
+	if (IS_ERR(nic->pool)) {
+		err = PTR_ERR(nic->pool);
+		goto err_napi;
+	}
+
+	/* Whatever the boot loader left running stops here */
+	rtl9300_nic_irq_disable_all(sw);
+	err = rtl9300_nic_reset(sw);
+	if (err)
+		goto err_pool;
+
+	err = rtl9300_rx_fill(nic);
+	if (err)
+		goto err_buffers;
+
+	err = rtl9300_nic_setup(sw);
+	if (err)
+		goto err_buffers;
+
+	err = request_irq(irq, rtl9300_nic_irq, IRQF_SHARED,
+			  dev_name(sw->dev), sw);
+	if (err)
+		goto err_buffers;
+
+	napi_enable(&nic->napi);
+
+	err = rtl9300_nic_start(sw);
+	if (err)
+		goto err_stop;
+
+	return 0;
+
+err_stop:
+	napi_disable(&nic->napi);
+	synchronize_net();
+	rtl9300_nic_irq_disable_all(sw);
+	free_irq(irq, sw);
+	rtl9300_nic_stop(sw);
+err_buffers:
+	rtl9300_rx_free(nic);
+err_pool:
+	page_pool_destroy(nic->pool);
+err_napi:
+	netif_napi_del(&nic->napi);
+	free_netdev(nic->napi_dev);
+	return err;
+}
+
+void rtl9300_nic_exit(struct rtl9300_sw *sw)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+
+	/* napi_disable() returns once the poll has given NAPI up, which can
+	 * be before it has unmasked the interrupts again; the poll runs with
+	 * BH off, so it is done after an RCU grace period
+	 */
+	napi_disable(&nic->napi);
+	synchronize_net();
+	rtl9300_nic_irq_disable_all(sw);
+	free_irq(nic->irq, sw);
+
+	/* The engine is idle after this, so its buffers can go */
+	rtl9300_nic_stop(sw);
+	rtl9300_rx_free(nic);
+
+	page_pool_destroy(nic->pool);
+	netif_napi_del(&nic->napi);
+	free_netdev(nic->napi_dev);
+}
