+#define   RTL9300_MAC_FORCE_DUPLEX		BIT(2)
+#define   RTL9300_MAC_FORCE_SPEED		GENMASK(6, 3)
+#define   RTL9300_MAC_FORCE_SPEED_1000		2
+#define   RTL9300_MAC_FORCE_FC_EN		BIT(9)
+
+/* DMA engine (NIC) of the CPU port. The RX ring size and counter
+ * registers hold a 10-bit field for each of three rings.
