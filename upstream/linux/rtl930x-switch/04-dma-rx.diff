+#define RTL9300_DMA_IF_RX_RING_SIZE(ring)	(0x7c60 + 4 * ((ring) / 3))
+#define RTL9300_DMA_IF_RX_RING_CNTR(ring)	(0x7c8c + 4 * ((ring) / 3))
+#define   RTL9300_DMA_IF_RX_RING_FIELD(ring)	\
