+}
+
+static const struct ethtool_ops rtl9300_port_ethtool_ops = {
+	.get_link = ethtool_op_get_link,
+	.get_link_ksettings = rtl9300_port_get_link_ksettings,
+	.set_link_ksettings = rtl9300_port_set_link_ksettings,
+	.nway_reset = rtl9300_port_nway_reset,
+	.get_pauseparam = rtl9300_port_get_pauseparam,
+	.set_pauseparam = rtl9300_port_set_pauseparam,
+};
+
+static bool rtl9300_node_available(struct device_node *np,
+				   const struct device_node *top)
+{
+	struct device_node *node = of_node_get(np);
+	bool available = true;
+
+	while (node && node != top) {
+		struct device_node *parent;
+
+		if (!of_device_is_available(node)) {
+			available = false;
+			break;
+		}
+
+		parent = of_get_parent(node);
+		of_node_put(node);
+		node = parent;
+	}
+
+	of_node_put(node);
+
+	return available;
+}
+
+/* Whether the PHY of a port is there (0), will be there (-EPROBE_DEFER)
+ * or never will: -ENXIO for a PHY that is disabled, or on a disabled MDIO
+ * bus, and -ENODEV for a port without a PHY. The ports are only probed
+ * once the MDIO driver has registered their PHYs; fw_devlink doesn't
+ * follow phy-handle, and the MDIO controller is a child of the switch
+ * anyway.
+ */
+static int rtl9300_port_find_phy(struct rtl9300_sw *sw, struct device_node *np)
+{
+	struct device_node *phy_np;
+	struct phy_device *phydev;
+	int err = 0;
+
+	phy_np = of_parse_phandle(np, "phy-handle", 0);
+	if (!phy_np)
+		return -ENODEV;
+
+	phydev = of_phy_find_device(phy_np);
+	if (phydev)
+		put_device(&phydev->mdio.dev);
+	else if (rtl9300_node_available(phy_np, sw->dev->of_node))
+		err = -EPROBE_DEFER;
+	else
+		err = -ENXIO;
+
+	of_node_put(phy_np);
+
+	return err;
+}
+
+static bool rtl9300_port_mode_supported(phy_interface_t mode)
+{
+	switch (mode) {
+	case PHY_INTERFACE_MODE_SGMII:
+	case PHY_INTERFACE_MODE_QSGMII:
+	case PHY_INTERFACE_MODE_USXGMII:
+	case PHY_INTERFACE_MODE_10G_QXGMII:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Checks a port node; -ENODEV for a port the driver doesn't run */
+static int rtl9300_port_parse(struct rtl9300_sw *sw, struct device_node *np,
+			      u32 *index, phy_interface_t *mode)
+{
+	struct device *dev = sw->dev;
+	int err;
+
+	err = of_property_read_u32(np, "reg", index);
+	if (err)
+		return dev_err_probe(dev, err, "%pOF: no port number\n", np);
+
+	if (*index >= RTL9300_NUM_PORTS)
+		return dev_err_probe(dev, -EINVAL, "%pOF: no port %u\n",
+				     np, *index);
+
+	err = of_get_phy_mode(np, mode);
+	if (err) {
+		dev_warn(dev, "port %u: no phy-mode\n", *index);
+		return -ENODEV;
+	}
+
+	err = rtl9300_port_find_phy(sw, np);
+	if (err == -EPROBE_DEFER) {
+		/* rtl9300_ports_check() gave up waiting for it */
+		dev_warn(dev, "port %u: PHY not found\n", *index);
+		return -ENODEV;
+	}
+	if (err == -ENXIO) {
+		dev_info(dev, "port %u: PHY disabled\n", *index);
+		return -ENODEV;
+	}
+	if (err) {
+		/* SerDes ports without a PHY need the PCS, which comes later */
+		dev_info(dev, "port %u: no PHY, not supported yet\n", *index);
+		return -ENODEV;
+	}
+
+	if (!rtl9300_port_mode_supported(*mode)) {
+		dev_info(dev, "port %u: %s not supported\n", *index,
+			 phy_modes(*mode));
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+/**
+ * rtl9300_ports_check - wait for what the ports need
+ * @sw: the switch
+ *
+ * The PHYs of the ports, and the NVMEM cells of their MAC addresses, have
+ * to be there before the hardware is set up, so that waiting for them is
+ * cheap. What doesn't come before the deferred probe timeout costs only
+ * its port, or the port's MAC address.
+ *
+ * Return: 0, -ENODEV without an ethernet-ports node, or -EPROBE_DEFER.
+ */
+int rtl9300_ports_check(struct rtl9300_sw *sw)
+{
+	struct device_node *ports_np;
+	struct device *dev = sw->dev;
+	int err = 0;
+
+	ports_np = of_get_child_by_name(dev->of_node, "ethernet-ports");
+	if (!ports_np)
+		return dev_err_probe(dev, -ENODEV, "no ethernet-ports\n");
+
+	for_each_available_child_of_node_scoped(ports_np, np) {
+		phy_interface_t mode;
+		u8 addr[ETH_ALEN];
+		int ret;
+
+		/* Ports the driver skips anyway */
+		if (of_get_phy_mode(np, &mode) ||
+		    !rtl9300_port_mode_supported(mode))
+			continue;
+
+		ret = rtl9300_port_find_phy(sw, np);
+		if (ret == -EPROBE_DEFER)
+			ret = driver_deferred_probe_check_state(dev);
+		if (ret == -EPROBE_DEFER) {
+			err = dev_err_probe(dev, ret,
+					    "%pOF: waiting for the PHY\n",
+					    np);
+			break;
+		}
+		/* No PHY, or no more waiting for it: the port is skipped */
+		if (ret)
+			continue;
+
+		ret = of_get_mac_address(np, addr);
+		if (ret == -EPROBE_DEFER)
+			ret = driver_deferred_probe_check_state(dev);
+		if (ret == -EPROBE_DEFER) {
+			err = dev_err_probe(dev, ret,
+					    "%pOF: waiting for its MAC address\n",
+					    np);
+			break;
+		}
+	}
+
+	of_node_put(ports_np);
+
+	return err;
+}
+
+static int rtl9300_port_create(struct rtl9300_sw *sw, struct device_node *np,
+			       u32 index, phy_interface_t mode)
+{
+	struct phylink_config *config;
+	struct rtl9300_port *port;
+	struct net_device *ndev;
+	struct phylink *pl;
+	int err;
+
+	if (sw->ports[index])
+		return dev_err_probe(sw->dev, -EINVAL, "port %u twice\n",
+				     index);
+
+	ndev = alloc_etherdev(sizeof(*port));
+	if (!ndev)
+		return -ENOMEM;
+
+	SET_NETDEV_DEV(ndev, sw->dev);
+	ndev->dev.of_node = of_node_get(np);
+	ndev->netdev_ops = &rtl9300_port_netdev_ops;
+	ndev->ethtool_ops = &rtl9300_port_ethtool_ops;
+	ndev->pcpu_stat_type = NETDEV_PCPU_STAT_DSTATS;
+	/* Room for the FCS the DMA engine adds. Making that room, or padding
+	 * a short frame, can change the skb, so one skb can't be sent twice.
+	 */
+	ndev->needed_tailroom = ETH_FCS_LEN;
+	ndev->priv_flags &= ~IFF_TX_SKB_SHARING;
+
+	port = netdev_priv(ndev);
+	port->sw = sw;
+	port->ndev = ndev;
+	port->index = index;
+
+	err = of_get_ethdev_address(np, ndev);
+	/* Only if rtl9300_ports_check() gave up waiting for an NVMEM cell */
+	if (err == -EPROBE_DEFER)
+		dev_warn(sw->dev, "port %u: MAC address not found\n", index);
+	if (err)
+		eth_hw_addr_random(ndev);
+
+	config = &port->phylink_config;
+	config->dev = &ndev->dev;
+	config->type = PHYLINK_NETDEV;
+	config->mac_capabilities = MAC_ASYM_PAUSE | MAC_SYM_PAUSE | MAC_10 |
+				   MAC_100 | MAC_1000FD | MAC_2500FD |
+				   MAC_5000FD | MAC_10000FD;
+	__set_bit(mode, config->supported_interfaces);
+
+	pl = phylink_create(config, of_fwnode_handle(np), mode,
+			    &rtl9300_phylink_mac_ops);
+	if (IS_ERR(pl)) {
+		err = PTR_ERR(pl);
+		goto err_free;
+	}
+	port->phylink = pl;
+
+	/* A PHY that fails to attach costs only its port */
+	err = phylink_of_phy_connect(pl, np, 0);
+	if (err) {
+		dev_err(sw->dev, "port %u: failed to attach the PHY: %pe\n",
+			index, ERR_PTR(err));
+		err = -ENODEV;
+		goto err_destroy;
+	}
+
+	/* The DMA engine looks the port up only once its interface is up */
+	sw->ports[index] = port;
+
+	err = register_netdev(ndev);
+	if (err) {
+		sw->ports[index] = NULL;
+		goto err_disconnect;
+	}
+
+	return 0;
+
+err_disconnect:
+	rtnl_lock();
+	phylink_disconnect_phy(pl);
+	rtnl_unlock();
+err_destroy:
+	phylink_destroy(pl);
+err_free:
+	of_node_put(ndev->dev.of_node);
+	free_netdev(ndev);
+	return err;
+}
+
+/**
+ * rtl9300_ports_init - create the network interfaces of the ports
+ * @sw: the switch
+ *
+ * On failure, the ports created so far are unregistered, but not freed:
+ * that is for rtl9300_ports_free() once the DMA engine is stopped.
+ *
+ * Return: 0 or a negative error.
+ */
+int rtl9300_ports_init(struct rtl9300_sw *sw)
+{
+	struct device_node *ports_np;
+	int err = 0;
+
+	ports_np = of_get_child_by_name(sw->dev->of_node, "ethernet-ports");
+	if (!ports_np)
+		return -ENODEV;
+
+	for_each_available_child_of_node_scoped(ports_np, np) {
+		phy_interface_t mode;
+		u32 index;
+
+		err = rtl9300_port_parse(sw, np, &index, &mode);
+		if (!err)
+			err = rtl9300_port_create(sw, np, index, mode);
+		/* A port the driver doesn't run */
+		if (err == -ENODEV)
+			err = 0;
+		if (err)
+			break;
+	}
+
+	of_node_put(ports_np);
+
+	if (err)
+		rtl9300_ports_unregister(sw);
+
+	return err;
+}
+
+/* Unregisters the network interfaces and detaches their PHYs */
+void rtl9300_ports_unregister(struct rtl9300_sw *sw)
+{
+	for (int i = 0; i < RTL9300_NUM_PORTS; i++) {
+		struct rtl9300_port *port = sw->ports[i];
+
+		if (!port)
+			continue;
+
+		unregister_netdev(port->ndev);
+
+		rtnl_lock();
+		phylink_disconnect_phy(port->phylink);
+		rtnl_unlock();
+		phylink_destroy(port->phylink);
+	}
+}
+
+/* Frees the ports, with the DMA engine stopped */
+void rtl9300_ports_free(struct rtl9300_sw *sw)
+{
+	for (int i = 0; i < RTL9300_NUM_PORTS; i++) {
+		struct rtl9300_port *port = sw->ports[i];
+
+		if (!port)
+			continue;
+
+		sw->ports[i] = NULL;
+		of_node_put(port->ndev->dev.of_node);
+		free_netdev(port->ndev);
+	}
+}
