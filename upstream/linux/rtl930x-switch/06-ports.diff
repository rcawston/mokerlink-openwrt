+	phylink_ethtool_get_pauseparam(port->phylink, pause);
+}
+
+static int rtl9300_port_set_pauseparam(struct net_device *ndev,
+				       struct ethtool_pauseparam *pause)
+{
+	struct rtl9300_port *port = netdev_priv(ndev);
