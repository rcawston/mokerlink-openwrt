+/**
+ * rtl9300_nic_port_open - let a port send and receive frames
+ * @port: the port, whose interface is being opened
+ */
+void rtl9300_nic_port_open(struct rtl9300_port *port)
+{
+	struct rtl9300_nic *nic = &port->sw->nic;
+	struct rtl9300_sw *sw = port->sw;
+
+	spin_lock_bh(&nic->tx_lock);
+
+	/* The port is in sw->ports[] before the poll sees it open */
+	smp_store_release(&sw->open_ports, sw->open_ports | BIT(port->index));
+
+	/* While the ring is full, the queue waits with the others */
+	if (nic->tx_stopped)
+		netif_stop_queue(port->ndev);
+	else
+		netif_start_queue(port->ndev);
+
+	spin_unlock_bh(&nic->tx_lock);
+}
+
+/**
+ * rtl9300_nic_port_stop - stop the frames of a port
+ * @port: the port, whose interface is being closed
+ */
+void rtl9300_nic_port_stop(struct rtl9300_port *port)
+{
+	struct rtl9300_nic *nic = &port->sw->nic;
+	struct rtl9300_sw *sw = port->sw;
+
+	spin_lock_bh(&nic->tx_lock);
+	WRITE_ONCE(sw->open_ports, sw->open_ports & ~BIT(port->index));
+	netif_stop_queue(port->ndev);
+	spin_unlock_bh(&nic->tx_lock);
+}
