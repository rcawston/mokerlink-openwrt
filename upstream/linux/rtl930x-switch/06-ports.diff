diff --git a/drivers/net/ethernet/realtek/rtl9300/rtl9300_port.c b/drivers/net/ethernet/realtek/rtl9300/rtl9300_port.c
new file mode 100644
index 00000000000..544eeda0f94
--- /dev/null
+++ b/drivers/net/ethernet/realtek/rtl9300/rtl9300_port.c
@@ -0,0 +1,599 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Realtek RTL930x switch: the front ports as network interfaces
+ *
+ * Every port of the ethernet-ports node with a PHY becomes a network
+ * interface. Its link is handled by phylink, and its PHY is attached when
+ * the port is created rather than when the interface is opened, as DSA
+ * does: the PHY's PSE control has to work while the interface is down,
+ * and attaching the PHY is what turns on the hardware polling of it in the
+ * MDIO driver, which the MAC takes its speed and duplex from.
+ *
+ * Copyright (C) 2026 Ross Cawston <ross@r-sc.ca>
+ */
+
+#include <linux/bitfield.h>
+#include <linux/device.h>
+#include <linux/etherdevice.h>
+#include <linux/iopoll.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/of_mdio.h>
+#include <linux/of_net.h>
+#include <linux/phy.h>
+#include <linux/phylink.h>
+#include <linux/rtnetlink.h>
+
+#include "rtl9300.h"
+#include "rtl9300_regs.h"
+
+static struct rtl9300_port *rtl9300_phylink_to_port(struct phylink_config *cfg)
+{
+	return container_of(cfg, struct rtl9300_port, phylink_config);
+}
+
+static void rtl9300_mac_config(struct phylink_config *config,
+			       unsigned int mode,
+			       const struct phylink_link_state *state)
+{
+	struct rtl9300_port *port = rtl9300_phylink_to_port(config);
+
+	/* The MAC follows the polling of its PHY, so nothing is forced */
+	regmap_write(port->sw->map,
+		     RTL9300_MAC_FORCE_MODE_CTRL(port->index), 0);
+}
+
+static int rtl9300_mac_speed(u32 code)
+{
+	switch (code) {
+	case RTL9300_MAC_LINK_SPD_10:
+		return SPEED_10;
+	case RTL9300_MAC_LINK_SPD_100:
+		return SPEED_100;
+	case RTL9300_MAC_LINK_SPD_1000:
+		return SPEED_1000;
+	case RTL9300_MAC_LINK_SPD_2500:
+		return SPEED_2500;
+	case RTL9300_MAC_LINK_SPD_5000:
+		return SPEED_5000;
+	case RTL9300_MAC_LINK_SPD_10000_LEGACY:
+	case RTL9300_MAC_LINK_SPD_10000:
+		return SPEED_10000;
+	default:
+		return SPEED_UNKNOWN;
+	}
+}
+
+/* Reads the link state the hardware polling gave the MAC */
+static int rtl9300_mac_state(struct rtl9300_port *port, int *speed,
+			     int *duplex)
+{
+	struct regmap *map = port->sw->map;
+	unsigned int p = port->index;
+	u32 link, spd, dup;
+	int err;
+
+	err = regmap_read(map, RTL9300_MAC_LINK_STS, &link);
+	if (err)
+		return err;
+
+	err = regmap_read(map, RTL9300_MAC_LINK_SPD_STS(p), &spd);
+	if (err)
+		return err;
+
+	err = regmap_read(map, RTL9300_MAC_LINK_DUP_STS, &dup);
+	if (err)
+		return err;
+
+	if (!(link & BIT(p))) {
+		*speed = SPEED_UNKNOWN;
+		*duplex = DUPLEX_UNKNOWN;
+		return 0;
+	}
+
+	*speed = rtl9300_mac_speed(field_get(RTL9300_MAC_LINK_SPD_MASK(p),
+					     spd));
+	*duplex = dup & BIT(p) ? DUPLEX_FULL : DUPLEX_HALF;
+
+	return 0;
+}
+
+static void rtl9300_mac_link_up(struct phylink_config *config,
+				struct phy_device *phydev, unsigned int mode,
+				phy_interface_t interface, int speed,
+				int duplex, bool tx_pause, bool rx_pause)
+{
+	struct rtl9300_port *port = rtl9300_phylink_to_port(config);
+	int mac_speed = SPEED_UNKNOWN, mac_duplex = DUPLEX_UNKNOWN;
+	struct regmap *map = port->sw->map;
+	unsigned int p = port->index;
+	u32 pause = 0;
+	int err, ret;
+
+	/* The polling sets speed and duplex, but pause is forced to what
+	 * phylink resolved, as OpenWrt does
+	 */
+	if (tx_pause)
+		pause |= RTL9300_MAC_FORCE_TX_PAUSE;
+	if (rx_pause)
+		pause |= RTL9300_MAC_FORCE_RX_PAUSE;
+
+	regmap_update_bits(map, RTL9300_MAC_FORCE_MODE_CTRL(p),
+			   RTL9300_MAC_FORCE_EN | RTL9300_MAC_FORCE_FC_EN |
+			   RTL9300_MAC_FORCE_TX_PAUSE |
+			   RTL9300_MAC_FORCE_RX_PAUSE,
+			   RTL9300_MAC_FORCE_FC_EN | pause);
+
+	/* With rate matching, phylink gives the speed and duplex of the
+	 * interface, and the polling reads those of the PHY's link
+	 */
+	if (phydev && phydev->rate_matching != RATE_MATCH_NONE) {
+		speed = phydev->speed;
+		duplex = phydev->duplex;
+	}
+
+	/* The polling has to give the MAC the link phylib reports. It may
+	 * lag behind phylib for a moment, and its link bit latches a loss
+	 * of link, so read it until it agrees or the time is up. A MAC that
+	 * doesn't agree stays off until the link goes down and up again.
+	 */
+	ret = read_poll_timeout(rtl9300_mac_state, err,
+				err || (mac_speed == speed &&
+					mac_duplex == duplex),
+				10000, 500000, false,
+				port, &mac_speed, &mac_duplex);
+	if (ret || err) {
+		netdev_err(port->ndev,
+			   "PHY link is %s/%s, but the MAC reports %s/%s; port disabled\n",
+			   phy_speed_to_str(speed), phy_duplex_to_str(duplex),
+			   phy_speed_to_str(mac_speed),
+			   phy_duplex_to_str(mac_duplex));
+		return;
+	}
+
+	regmap_set_bits(map, RTL9300_MAC_L2_PORT_CTRL(p),
+			RTL9300_MAC_L2_PORT_TXRX_EN);
+}
+
+static void rtl9300_mac_link_down(struct phylink_config *config,
+				  unsigned int mode, phy_interface_t interface)
+{
+	struct rtl9300_port *port = rtl9300_phylink_to_port(config);
+
+	regmap_clear_bits(port->sw->map, RTL9300_MAC_L2_PORT_CTRL(port->index),
+			  RTL9300_MAC_L2_PORT_TXRX_EN);
+}
+
+static const struct phylink_mac_ops rtl9300_phylink_mac_ops = {
+	.mac_config = rtl9300_mac_config,
+	.mac_link_up = rtl9300_mac_link_up,
+	.mac_link_down = rtl9300_mac_link_down,
+};
+
+static int rtl9300_port_open(struct net_device *ndev)
+{
+	struct rtl9300_port *port = netdev_priv(ndev);
+
+	phylink_start(port->phylink);
+	rtl9300_nic_port_open(port);
+
+	return 0;
+}
+
+static int rtl9300_port_stop(struct net_device *ndev)
+{
+	struct rtl9300_port *port = netdev_priv(ndev);
+
+	rtl9300_nic_port_stop(port);
+	phylink_stop(port->phylink);
+
+	return 0;
+}
+
+static netdev_tx_t rtl9300_port_xmit(struct sk_buff *skb,
+				     struct net_device *ndev)
+{
+	struct rtl9300_port *port = netdev_priv(ndev);
+
+	return rtl9300_nic_xmit(port->sw, skb, ndev, port->index);
+}
+
+static int rtl9300_port_ioctl(struct net_device *ndev, struct ifreq *ifr,
+			      int cmd)
+{
+	struct rtl9300_port *port = netdev_priv(ndev);
+
+	return phylink_mii_ioctl(port->phylink, ifr, cmd);
+}
+
+static const struct net_device_ops rtl9300_port_netdev_ops = {
+	.ndo_open = rtl9300_port_open,
+	.ndo_stop = rtl9300_port_stop,
+	.ndo_start_xmit = rtl9300_port_xmit,
+	.ndo_eth_ioctl = rtl9300_port_ioctl,
+	.ndo_set_mac_address = eth_mac_addr,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
