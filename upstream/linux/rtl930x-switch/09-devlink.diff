+/* The devlink port gives the interface its physical port name and the
+ * switch ID it shares with the other ports
+ */
+static int rtl9300_port_devlink_init(struct rtl9300_port *port)
+{
+	struct devlink_port_attrs attrs = {
+		.flavour = DEVLINK_PORT_FLAVOUR_PHYSICAL,
+		.phys.port_number = port->index,
+	};
+	struct rtl9300_sw *sw = port->sw;
