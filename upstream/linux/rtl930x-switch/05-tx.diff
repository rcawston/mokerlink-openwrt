+static void rtl9300_tx_init(struct rtl9300_nic *nic)
+{
+	for (unsigned int i = 0; i < RTL9300_TX_RING_SIZE; i++) {
+		u32 entry = lower_32_bits(rtl9300_tx_desc_dma(nic, i));
+
+		if (i == RTL9300_TX_RING_SIZE - 1)
+			entry |= RTL9300_RING_WRAP;
+
+		nic->rings->tx_ring[i] = cpu_to_be32(entry);
+	}
+
+	nic->tx_head = 0;
+	nic->tx_tail = 0;
+}
+
+/* Frees the frames the hardware has sent */
+static void rtl9300_tx_reclaim(struct rtl9300_sw *sw, int budget)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+
+	spin_lock(&nic->tx_lock);
+
+	while (nic->tx_tail != nic->tx_head) {
+		unsigned int i = nic->tx_tail & (RTL9300_TX_RING_SIZE - 1);
+		u32 entry = be32_to_cpu(READ_ONCE(nic->rings->tx_ring[i]));
+
+		if (entry & RTL9300_RING_OWN)
+			break;
+
+		dma_unmap_single(sw->dev, nic->tx_dma[i], nic->tx_len[i],
+				 DMA_TO_DEVICE);
+		napi_consume_skb(nic->tx_skb[i], budget);
+		nic->tx_skb[i] = NULL;
+		nic->tx_tail++;
+	}
+
+	spin_unlock(&nic->tx_lock);
+}
+
+/* Frees the frames that were never sent, with the engine stopped */
+static void rtl9300_tx_free(struct rtl9300_sw *sw)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+
+	for (unsigned int i = 0; i < RTL9300_TX_RING_SIZE; i++) {
+		if (!nic->tx_skb[i])
+			continue;
+
+		dma_unmap_single(sw->dev, nic->tx_dma[i], nic->tx_len[i],
+				 DMA_TO_DEVICE);
+		kfree_skb(nic->tx_skb[i]);
+		nic->tx_skb[i] = NULL;
+	}
+}
+
+/* Triggers TX ring 0. Reads of the control register sometimes come back
+ * empty, and writing such a value back would stop the engine (OpenWrt), so
+ * it is written as a whole, with the engine on as rtl9300_nic_start() left
+ * it.
+ */
+static void rtl9300_tx_trigger(struct rtl9300_sw *sw)
+{
+	regmap_write(sw->map, RTL9300_DMA_IF_CTRL,
+		     RTL9300_DMA_IF_TXRX_EN | RTL9300_DMA_IF_TX_TRIGGER(0));
+}
+
+/* OpenWrt unmasked the TX done interrupts from 2021 until January 2026, but
+ * only acknowledged them, as it copies the frames it sends, and that bit 0
+ * is TX ring 0 is inferred from the RX registers. So while frames are in
+ * the ring, a timer also kicks the engine, in case a trigger was lost, and
+ * the poll, which frees what was sent, as the TX coalescing timer of stmmac
+ * does.
+ */
+static void rtl9300_tx_timer(struct timer_list *t)
+{
+	struct rtl9300_nic *nic = timer_container_of(nic, t, tx_timer);
+	struct rtl9300_sw *sw = rtl9300_nic_to_sw(nic);
+	bool busy;
+
+	spin_lock(&nic->tx_lock);
+	busy = nic->tx_head != nic->tx_tail;
+	if (busy) {
+		rtl9300_tx_trigger(sw);
+		mod_timer(&nic->tx_timer, jiffies + RTL9300_TX_TIMER_TICKS);
+	}
+	spin_unlock(&nic->tx_lock);
+
+	if (busy)
+		napi_schedule(&nic->napi);
+}
