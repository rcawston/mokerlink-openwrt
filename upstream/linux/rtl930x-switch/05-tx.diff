+/**
+ * rtl9300_nic_xmit - send a frame out of one port
+ * @sw: the switch
+ * @skb: the frame, without FCS
+ * @ndev: the network interface of the port, for its statistics
+ * @port: the front port
+ *
+ * Return: NETDEV_TX_BUSY, with the frame untouched, when the ring is full;
+ * NETDEV_TX_OK otherwise, when the frame is queued or dropped.
+ */
+netdev_tx_t rtl9300_nic_xmit(struct rtl9300_sw *sw, struct sk_buff *skb,
+			     struct net_device *ndev, unsigned int port)
+{
+	struct rtl9300_nic *nic = &sw->nic;
+	struct rtl9300_desc *desc;
+	unsigned int i, len;
+	dma_addr_t dma;
+	u32 entry;
+
+	spin_lock(&nic->tx_lock);
+
+	if (nic->tx_head - nic->tx_tail >= RTL9300_TX_RING_SIZE) {
+		spin_unlock(&nic->tx_lock);
+		return NETDEV_TX_BUSY;
+	}
+
+	/* The descriptor's length is 16 bits, and the switch takes no longer
+	 * frame from the CPU anyway
+	 */
+	if (skb->len + ETH_FCS_LEN > RTL9300_MAX_FRAME)
+		goto drop;
+
+	/* The engine sends the FCS in place of the last four bytes of the
+	 * buffer, which come from the tailroom, and only reads the buffer.
+	 * The bytes are zeroed where the frame owns its buffer; a clone
+	 * shares it, so there they stay as they are.
+	 */
+	if (skb_put_padto(skb, ETH_ZLEN))
+		goto drop_freed;
+	if (skb_tailroom(skb) < ETH_FCS_LEN) {
+		if (skb_pad(skb, ETH_FCS_LEN))
+			goto drop_freed;
+	} else if (!skb_cloned(skb)) {
+		memset(skb_tail_pointer(skb), 0, ETH_FCS_LEN);
+	}
+	len = skb->len + ETH_FCS_LEN;
+
+	dma = dma_map_single(sw->dev, skb->data, len, DMA_TO_DEVICE);
+	if (dma_mapping_error(sw->dev, dma))
+		goto drop;
+
+	i = nic->tx_head & (RTL9300_TX_RING_SIZE - 1);
+	nic->tx_skb[i] = skb;
+	nic->tx_dma[i] = dma;
+	nic->tx_len[i] = len;
+
+	desc = &nic->rings->tx_desc[i];
+	memset(desc, 0, sizeof(*desc));
+	desc->addr = cpu_to_be32(lower_32_bits(dma));
+	desc->len = cpu_to_be16(len);
+	desc->tag[0] = cpu_to_be16(RTL9300_TX_TAG0_CPU_TAG);
+	desc->tag[1] = cpu_to_be16(FIELD_PREP(RTL9300_TX_TAG1_FWD_TYPE,
+					      RTL9300_TX_FWD_PHYSICAL) |
+				   RTL9300_TX_TAG1_IGNORE_STP);
+	desc->tag[6] = cpu_to_be16(upper_16_bits(BIT(port)));
+	desc->tag[7] = cpu_to_be16(lower_16_bits(BIT(port)));
+
+	entry = lower_32_bits(rtl9300_tx_desc_dma(nic, i)) | RTL9300_RING_OWN;
+	if (i == RTL9300_TX_RING_SIZE - 1)
+		entry |= RTL9300_RING_WRAP;
+
+	/* The descriptor must be complete before the entry hands it over */
+	dma_wmb();
+	WRITE_ONCE(nic->rings->tx_ring[i], cpu_to_be32(entry));
+	nic->tx_head++;
+
+	skb_tx_timestamp(skb);
+	rtl9300_tx_trigger(sw);
+	if (!timer_pending(&nic->tx_timer))
+		mod_timer(&nic->tx_timer, jiffies + RTL9300_TX_TIMER_TICKS);
+
+	spin_unlock(&nic->tx_lock);
+
+	return NETDEV_TX_OK;
+
+drop:
+	dev_kfree_skb_any(skb);
+drop_freed:
+	spin_unlock(&nic->tx_lock);
+	dev_dstats_tx_dropped(ndev);
+
+	return NETDEV_TX_OK;
+}
