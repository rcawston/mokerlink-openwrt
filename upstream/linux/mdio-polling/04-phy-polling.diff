+static const struct otto_emdio_phy otto_emdio_phys[] = {
+	{ .phy_id = RTL8218D_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8218E_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8221B_VB_CG_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8221B_VM_CG_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8224_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8226_PHY_ID, .giga_lite = true },
+	{ .phy_id = RTL8261N_PHY_ID, .giga_lite = true, .res_reg = true },
+	{ .phy_id = RTL8264_PHY_ID, .giga_lite = true, .res_reg = true },
+	{ .phy_id = RTL8264B_PHY_ID, .giga_lite = true, .res_reg = true },
+};
