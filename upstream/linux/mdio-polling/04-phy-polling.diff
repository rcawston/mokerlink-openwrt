+static int otto_emdio_9310_set_status_reg(struct otto_emdio_priv *priv, int mdio_bus,
+					  bool res_reg)
+{
+	int err;
+
+	err = regmap_assign_bits(priv->regmap, RTL9310_SMI_GLB_CTRL0,
+				 RTL9310_SMI_GLB_PRVTE0_POLL(mdio_bus), res_reg);
+	if (err)
+		return err;
+
+	/* None of the PHYs below needs the second private polling or a forced format */
+	err = regmap_clear_bits(priv->regmap, RTL9310_SMI_GLB_CTRL0,
+				RTL9310_SMI_GLB_PRVTE1_POLL(mdio_bus));
+	if (err)
+		return err;
+
+	return regmap_clear_bits(priv->regmap, RTL9310_SMI_GLB_CTRL1,
+				 RTL9310_SMI_GLB_FMT_SEL_FRC(mdio_bus));
+}
