+/* A PHY found with C45 has no C22 ID, so use the first ID one of its MMDs reports */
+static u32 otto_emdio_phy_id(struct phy_device *phydev)
+{
+	if (phydev->is_c45) {
+		for (int i = 0; i < ARRAY_SIZE(phydev->c45_ids.device_ids); i++) {
+			u32 id = phydev->c45_ids.device_ids[i];
+
+			if (id && id != 0xffffffff)
+				return id;
+		}
+	}
+
+	return phydev->phy_id;
+}
+
+static const struct otto_emdio_phy *otto_emdio_find_phy(struct phy_device *phydev)
+{
+	u32 id = otto_emdio_phy_id(phydev);
+
+	for (int i = 0; i < ARRAY_SIZE(otto_emdio_phys); i++)
+		if (otto_emdio_phys[i].phy_id == id)
+			return &otto_emdio_phys[i];
+
+	return NULL;
+}
+
+static int otto_emdio_setup_phy_polling(struct otto_emdio_priv *priv, int port,
+					struct phy_device *phydev)
+{
+	const struct otto_emdio_info *info = priv->info;
+	u8 mdio_bus = priv->smi_bus[port];
+	const struct otto_emdio_phy *phy;
+	enum otto_emdio_status_reg status;
+	int err;
+
+	if (!info->set_status_reg)
+		return 0;
+
+	phy = otto_emdio_find_phy(phydev);
+	if (!phy) {
+		phydev_info(phydev, "polling not set up for this PHY, keeping the boot loader's\n");
+		return 0;
+	}
+
+	if (info->set_giga_lite) {
+		err = info->set_giga_lite(priv, port, phy->giga_lite);
+		if (err)
+			return err;
+	}
+
+	/*
+	 * The status register is chosen for a whole bus by the first PHY that attaches, and set
+	 * again by every PHY like it. All PHYs of a bus are expected to be alike.
+	 */
+	status = phy->res_reg ? OTTO_EMDIO_STATUS_RESOLUTION : OTTO_EMDIO_STATUS_STANDARD;
+	guard(mutex)(&priv->lock);
+
+	if (priv->status_reg[mdio_bus] != OTTO_EMDIO_STATUS_UNSET &&
+	    priv->status_reg[mdio_bus] != status) {
+		phydev_warn(phydev, "polling of bus %u is set up for another PHY type\n", mdio_bus);
+	} else {
+		err = info->set_status_reg(priv, mdio_bus, phy->res_reg);
+		if (err)
+			return err;
+
+		priv->status_reg[mdio_bus] = status;
+	}
+
+	return 0;
+}
