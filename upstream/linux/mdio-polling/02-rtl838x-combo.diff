diff --git a/drivers/net/mdio/mdio-realtek-rtl9300.c b/drivers/net/mdio/mdio-realtek-rtl9300.c
index 94cb15714f6..8aa029b45a8 100644
--- a/drivers/net/mdio/mdio-realtek-rtl9300.c
+++ b/drivers/net/mdio/mdio-realtek-rtl9300.c
@@ -130,6 +130,7 @@
 #define RTL8380_NUM_PORTS			28
 #define RTL8380_SMI_GLB_CTRL			0xa100
 #define   RTL8380_SMI_FREQ_SEL			BIT(1)
+#define   RTL8380_SMI_PHY_MAN_24_27		BIT(7)
 #define   RTL8380_SMI_PHY_PATCH_DONE		BIT(15)
 #define RTL8380_SMI_ACCESS_PHY_CTRL_0		0xa1b8
 #define RTL8380_SMI_ACCESS_PHY_CTRL_1		0xa1bc
@@ -766,11 +767,23 @@ static int otto_emdio_8380_set_bus_frequency(struct mii_bus *bus, u32 freq)
 
 static int otto_emdio_8380_setup_controller(struct otto_emdio_priv *priv)
 {
+	int err;
+
 	/*
 	 * PHY_PATCH_DONE enables PHY control via SoC. This is required for PHY access, including
 	 * patching and must be set before the PHYs are probed.
 	 */
-	return regmap_set_bits(priv->regmap, RTL8380_SMI_GLB_CTRL, RTL8380_SMI_PHY_PATCH_DONE);
+	err = regmap_set_bits(priv->regmap, RTL8380_SMI_GLB_CTRL, RTL8380_SMI_PHY_PATCH_DONE);
+	if (err)
+		return err;
+
+	/*
+	 * Ports 24-27 may sit on a combo PHY (RTL8214FC) with a copper and a fibre medium. Only
+	 * with PHY_MAN_24_27 set does MAC_LINK_MEDIA_STS report which medium such a port uses.
+	 * Assume a combo PHY when port 24 has a PHY at all.
+	 */
+	return regmap_assign_bits(priv->regmap, RTL8380_SMI_GLB_CTRL, RTL8380_SMI_PHY_MAN_24_27,
+				  test_bit(24, priv->valid_ports));
 }
 
 static int otto_emdio_8390_set_bus_frequency(struct mii_bus *bus, u32 freq)
