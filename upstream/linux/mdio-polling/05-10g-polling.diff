+static int otto_emdio_set_poll_regs(struct otto_emdio_priv *priv,
+				    const struct otto_emdio_poll_regs *regs)
+{
+	const u32 *cfg = priv->info->poll_cfg;
+	int err;
+
+	err = regmap_write(priv->regmap, cfg[0], regs->duplex);
+	if (err)
+		return err;
+
+	err = regmap_write(priv->regmap, cfg[1], regs->adv_1000);
+	if (err)
+		return err;
+
+	return regmap_write(priv->regmap, cfg[2], regs->lpa_1000);
+}
