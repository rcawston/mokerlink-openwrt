+	{ .phy_id = RTL8221B_VB_CG_PHY_ID, .giga_lite = true, .poll = &otto_emdio_poll_realtek },
+	{ .phy_id = RTL8221B_VM_CG_PHY_ID, .giga_lite = true, .poll = &otto_emdio_poll_realtek },
